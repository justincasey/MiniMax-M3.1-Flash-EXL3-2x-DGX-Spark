# 2.15 bpw lane: 524288 context x 4 streams. 28 GiB pool (1.09M tokens): two streams at full length, ~273K tokens each when all four are long; vLLM preempts beyond that.
# Measurements and the pool cap: config/profiles/lane-2.15.inc.
: "${MAX_MODEL_LEN:=524288}"
: "${MAX_NUM_SEQS:=4}"
: "${KVB:=30064771072}"
. "$ROOT/config/profiles/lane-2.15.inc"
PROFILE_MEASURED=0
