# Default 2.15 bpw profile. Base flags are tonyd2wild's 2.15 TP2 set
# (MiniMax-M3.1-Flash-EXL3-TP2-2x-DGX-Spark @ 70c4e43, scripts/m31_tp2.sh): 300,000-token
# context, 6 streams, a 726,656-token q4 KV pool from 20,000,000,000 bytes per rank. The
# chunk and fat-tier knobs below were tuned for this recipe (PERFORMANCE.md: prefill 1561
# tok/s, decode 30.8 / 66.4 tok/s at 1 / 4 streams, ready ~104 s, ready MemAvailable
# >= 25 GiB per node). Still PROFILE_MEASURED=0: no bench/records/ entry.
: "${MAX_MODEL_LEN:=300000}"
: "${MAX_NUM_SEQS:=6}"
: "${KVB:=20000000000}"
: "${CAPTURE_SIZES:=1,2,3,4,8,12,16,24}"
# 16K chunks: an 8.9K-token prompt is one chunk instead of 8192 + a small tail, and per-chunk costs
# (dense weight reconstruct, partial fat-GEMM tiles) amortize over twice the rows. One test pair:
# 8K/16K prompts 1436/1432 vs 1282/1346 tok/s; ready 103.5 s; ready-stage MemAvailable >= 22 GiB.
# Latency trade: a 16K chunk step takes ~11 s, so decode streams running beside a long prefill
# stall that long per chunk (8K chunks: ~5.5 s). 32K chunks were rejected: their +5.8% on the
# 17.7K benchmark prompt is mostly the absorbed 1.3K tail chunk (diluted on long real prompts),
# and they double the stall to ~20 s.
: "${MAX_NUM_BATCHED_TOKENS:=16384}"
# Experts with > 128 rows take the grouped fat tier (fat vs trellis ~1e-3 per layer). In
# batches of >= 1024 tokens (prefill chunks) every routed expert does: real routing is skewed
# (a 16K chunk leaves ~37 experts per layer with 1-32 rows), and those fill the fat launch's
# idle tail SMs for ~1/3 of their mixed-K kernel cost. One test pair, 8K/16K prompts: 1518/1494 vs
# 1460/1461 at threshold 32. Short batches stay at 128: that also bounds coop decode
# eligibility, worth ~10% at c=4 in one decode screen on one pair (not replicated).
: "${FAT_THRESHOLD:=128}"
: "${FAT_THRESHOLD_PREFILL:=0}"
: "${FAT_PREFILL_TOKENS:=1024}"
PROFILE_MEASURED=0
