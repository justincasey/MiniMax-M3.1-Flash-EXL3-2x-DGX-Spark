# 2.15 bpw lane: 262144 context x 8 streams. 28 GiB pool (1.09M tokens): four streams at full length, ~136K tokens each when all eight are long; vLLM preempts beyond that.
# Measurements and the pool cap: config/profiles/lane-2.15.inc.
: "${MAX_MODEL_LEN:=262144}"
: "${MAX_NUM_SEQS:=8}"
: "${KVB:=30064771072}"
. "$ROOT/config/profiles/lane-2.15.inc"
PROFILE_MEASURED=0
