+template <int CB, bool scatter>
+void launch_cb(int64_t K, at::Tensor a, at::Tensor packed, at::Tensor out, at::Tensor svh,
+               at::Tensor token_idx, at::Tensor route_weight)
+{
+    switch (K)
+    {
+        case 1: launch_k<1, CB, scatter>(a, packed, out, svh, token_idx, route_weight); break;
+        case 2: launch_k<2, CB, scatter>(a, packed, out, svh, token_idx, route_weight); break;
+        case 3: launch_k<3, CB, scatter>(a, packed, out, svh, token_idx, route_weight); break;
+        case 4: launch_k<4, CB, scatter>(a, packed, out, svh, token_idx, route_weight); break;
+        case 5: launch_k<5, CB, scatter>(a, packed, out, svh, token_idx, route_weight); break;
+        case 6: launch_k<6, CB, scatter>(a, packed, out, svh, token_idx, route_weight); break;
+        case 7: launch_k<7, CB, scatter>(a, packed, out, svh, token_idx, route_weight); break;
+        case 8: launch_k<8, CB, scatter>(a, packed, out, svh, token_idx, route_weight); break;
+        default: TORCH_CHECK(false, "exl3_fat_gemm: unsupported K ", K);
+    }
+}
+
+// Codebook index as exllamav3's dq_dispatch takes it: 0 = 3INST, 1 = MCG, 2 = MUL1.
+template <bool scatter>
+void launch(int64_t K, bool mcg, bool mul1, at::Tensor a, at::Tensor packed, at::Tensor out,
+            at::Tensor svh, at::Tensor token_idx, at::Tensor route_weight)
+{
+    if (mcg) launch_cb<1, scatter>(K, a, packed, out, svh, token_idx, route_weight);
+    else if (mul1) launch_cb<2, scatter>(K, a, packed, out, svh, token_idx, route_weight);
+    else launch_cb<0, scatter>(K, a, packed, out, svh, token_idx, route_weight);
+}
+
 }  // namespace
 
 void exl3_fat_gemm(
@@ -275,7 +307,7 @@ void exl3_fat_gemm(
