     TORCH_CHECK(out.size(0) == a.size(0) && out.size(1) == svh.numel(),
                 "out shape must be [M, N]");
-    launch<false>(a, packed, out, svh, at::Tensor(), at::Tensor());
+    launch<false>(K, mcg, mul1, a, packed, out, svh, at::Tensor(), at::Tensor());
 }
 
