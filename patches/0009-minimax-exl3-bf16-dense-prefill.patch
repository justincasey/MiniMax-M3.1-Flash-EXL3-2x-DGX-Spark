                 dst.copy_(kernel.apply_weights(shim, x_2d))
             elif i in bf16_shards:
-                b = bf16_shards.index(i)
-                start = sum(int(sizes[j]) for j in bf16_shards[:b])
+                j = bf16_shards.index(i)
+                start = sum(int(sizes[s]) for s in bf16_shards[:j])
