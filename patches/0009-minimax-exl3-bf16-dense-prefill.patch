diff --git a/tests/gpu/bench_bf16_dense.py b/tests/gpu/bench_bf16_dense.py
new file mode 100644
index 0000000..7435a99
--- /dev/null
+++ b/tests/gpu/bench_bf16_dense.py
@@ -0,0 +1,97 @@
+"""Dense EXL3 prefill layer: today's fp16 path vs a bf16 single-GEMM path (run in the image).
+
+today: x bf16 -> fp16 copy; per shard reconstruct_had_slice (fp16, original basis) +
+       hgemm_recon (fp32 out); cat; fp32 -> bf16 cast.
+bf16:  per shard reconstruct_had_slice into fp16 scratch, cast into its column block of one
+       bf16 weight [K, sum N]; one bf16 GEMM x @ W written straight into the bf16 output.
+Shapes are the 2.15 lane's per-rank layers at M = 8192.
+"""
+import time
+
+import torch
+from exllamav3.ext import exllamav3_ext as ext
+
+dev = "cuda"
+torch.manual_seed(0)
+
+
+def shard(k, n, bits=3):
+    tr = torch.randint(-32768, 32767, (k // 16, n // 16, 16 * bits), dtype=torch.int16, device=dev)
+    suh = (torch.where(torch.rand(k, device=dev) < 0.5, -1.0, 1.0) * 0.02).half()
+    svh = (torch.where(torch.rand(n, device=dev) < 0.5, -1.0, 1.0) * 0.02).half()
+    return dict(tr=tr, suh=suh, svh=svh, K=bits, k=k, n=n)
+
+
+def timeit(fn, n=10):
+    fn()
+    torch.cuda.synchronize()
+    t = time.perf_counter()
+    for _ in range(n):
+        fn()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - t) / n * 1e3
+
+
+LAYERS = {
+    "attn qkv (q|k|v)": (6144, [4096, 256, 256]),
+    "attn o_proj": (4096, [6144]),
+    "shared gate_up": (6144, [1536, 1536]),
+    "shared down": (1536, [6144]),
+    "dense gate_up": (6144, [6144, 6144]),
+    "dense down": (6144, [6144]),
+}
+m = 8192
+for name, (k, ns) in LAYERS.items():
+    shards = [shard(k, n) for n in ns]
+    x = (torch.randn(m, k, device=dev) * 2).bfloat16()
+    total = sum(ns)
+    w16 = torch.empty(k, max(ns), dtype=torch.half, device=dev)
+    wb = torch.empty(k, total, dtype=torch.bfloat16, device=dev)
+    yb = torch.empty(m, total, dtype=torch.bfloat16, device=dev)
+
+    def today():
+        xh = x.to(torch.float16)
+        outs = []
+        for s in shards:
+            w = w16[:, : s["n"]] if s["n"] == w16.shape[1] else torch.empty(k, s["n"], dtype=torch.half, device=dev)
+            ext.reconstruct_had_slice(w, s["tr"], s["suh"], s["svh"], s["K"], True, False, 0)
+            y = torch.empty(m, s["n"], dtype=torch.float32, device=dev)
+            ext.hgemm_recon(xh, w, y)
+            outs.append(y)
+        return (torch.cat(outs, dim=1) if len(outs) > 1 else outs[0]).to(torch.bfloat16)
+
+    def bf16():
+        off = 0
+        for s in shards:
+            w = w16[:, : s["n"]] if s["n"] == w16.shape[1] else torch.empty(k, s["n"], dtype=torch.half, device=dev)
+            ext.reconstruct_had_slice(w, s["tr"], s["suh"], s["svh"], s["K"], True, False, 0)
+            wb[:, off : off + s["n"]].copy_(w)
+            off += s["n"]
+        torch.mm(x, wb, out=yb)
+        return yb
+
+    w16m = torch.empty(k, total, dtype=torch.half, device=dev)
+    y32 = torch.empty(m, total, dtype=torch.float32, device=dev)
+
+    def fp16_merged():
+        xh = x.to(torch.float16)
+        off = 0
+        for s in shards:
+            if len(shards) == 1:
+                ext.reconstruct_had_slice(w16m, s["tr"], s["suh"], s["svh"], s["K"], True, False, 0)
+            else:
+                w = w16[:, : s["n"]] if s["n"] == w16.shape[1] else torch.empty(k, s["n"], dtype=torch.half, device=dev)
+                ext.reconstruct_had_slice(w, s["tr"], s["suh"], s["svh"], s["K"], True, False, 0)
+                w16m[:, off : off + s["n"]].copy_(w)
+            off += s["n"]
+        ext.hgemm_recon(xh, w16m, y32)
+        return y32.to(torch.bfloat16)
+
+    ref = today().float()
+    rel_m = ((fp16_merged().float() - ref).norm() / ref.norm()).item()
+    t_m = timeit(fp16_merged)
+    got = bf16().float()
+    rel = ((got - ref).norm() / ref.norm()).item()
+    ptr_ok = bf16().data_ptr() == yb.data_ptr()
+    t0, t1 = timeit(today), timeit(bf16)
+    print(f"{name:<18} M={m} {k}->{ns}: today {t0:.2f} ms | bf16 single GEMM {t1:.2f} ms ({t0 / t1:.2f}x) | rel {rel:.1e} | fp16 merged {t_m:.2f} ms ({t0 / t_m:.2f}x, rel {rel_m:.1e})")
diff --git a/tests/gpu/test_wide_prefill.py b/tests/gpu/test_wide_prefill.py
new file mode 100644
index 0000000..b006730
--- /dev/null
+++ b/tests/gpu/test_wide_prefill.py
@@ -0,0 +1,85 @@
+"""Exl3LinearMethod._apply_wide_prefill (bf16 mode) vs the fp16 reconstruct path (run in the image).
+
+A fake fused layer [EXL3 q | EXL3 k | EXL3 v | BF16 shard] like the MiniMax qkv+indexer layout:
+- bf16 output equals the fp16 path (reconstruct_had_slice + hgemm fp32, cast) to bf16 weight
+  rounding (rel < 5e-3), and the BF16 shard's columns equal F.linear exactly;
+- rows below VLLM_EXL3_BF16_PREFILL_MIN_ROWS return None (fp16 path keeps them);
+- timing vs the fp16 path including its casts and cat.
+"""
+import sys
+import time
+import types
+
+sys.path.insert(0, "/src/src")
+import torch
+import torch.nn.functional as F
+from exllamav3.ext import exllamav3_ext as ext
+
+from vllm_exl3 import exl3 as X
+
+dev = "cuda"
+torch.manual_seed(0)
+fails = 0
+
+
+def lin(k, n, bits):
+    return types.SimpleNamespace(
+        in_features=k, out_features=n, K=bits, mcg=True, mul1=False, bias=None,
+        trellis=torch.randint(-32768, 32767, (k // 16, n // 16, 16 * bits), dtype=torch.int16, device=dev),
+        suh=(torch.where(torch.rand(k, device=dev) < 0.5, -1.0, 1.0) * 0.02).half(),
+        svh=(torch.where(torch.rand(n, device=dev) < 0.5, -1.0, 1.0) * 0.02).half(),
+    )
+
+
+k, sizes = 6144, [4096, 256, 256, 512]
+linears = [lin(k, 4096, 3), lin(k, 256, 2), lin(k, 256, 4), None]
+bf16_w = (torch.randn(512, k, device=dev) * 0.01).bfloat16()
+layer = types.SimpleNamespace(
+    _exl3_linear_output_partition_sizes=sizes, _exl3_linear_bf16_shards=[3], _exl3_bf16_weight=bf16_w,
+    prefix="test.qkv",
+)
+method = X.Exl3LinearMethod.__new__(X.Exl3LinearMethod)
+
+
+def fp16_path(x):
+    xh = x.to(torch.float16)
+    outs = []
+    for l in linears[:3]:
+        w = torch.empty(k, l.out_features, dtype=torch.half, device=dev)
+        ext.reconstruct_had_slice(w, l.trellis, l.suh, l.svh, l.K, l.mcg, l.mul1, 0)
+        y = torch.empty(x.shape[0], l.out_features, dtype=torch.float32, device=dev)
+        ext.hgemm_recon(xh, w, y)
+        outs.append(y)
+    outs.append(F.linear(x, bf16_w).float())
+    return torch.cat(outs, dim=1).to(torch.bfloat16)
+
+
+x = (torch.randn(4096, k, device=dev) * 2).bfloat16()
+y = method._apply_wide_prefill(layer, linears, x)
+ref = fp16_path(x)
+r_exl3 = ((y[:, :4608].float() - ref[:, :4608].float()).norm() / ref[:, :4608].float().norm()).item()
+r_bf16 = ((y[:, 4608:].float() - ref[:, 4608:].float()).norm() / ref[:, 4608:].float().norm()).item()
+ok = y.dtype == torch.bfloat16 and r_exl3 < 5e-3 and r_bf16 == 0.0
+fails += not ok
+print(f"bf16 wide prefill: EXL3 columns rel {r_exl3:.1e}, BF16-shard columns rel {r_bf16:.1e} {'OK' if ok else 'FAIL'}")
+
+small = method._apply_wide_prefill(layer, linears, x[:512].contiguous())
+ok = small is None
+fails += not ok
+print(f"512 rows (< min rows) -> fp16 path: {small is None} {'OK' if ok else 'FAIL'}")
+
+
+def timeit(fn, n=10):
+    fn()
+    torch.cuda.synchronize()
+    t = time.perf_counter()
+    for _ in range(n):
+        fn()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - t) / n * 1e3
+
+
+x8 = (torch.randn(8192, k, device=dev) * 2).bfloat16()
+t16, tb = timeit(lambda: fp16_path(x8)), timeit(lambda: method._apply_wide_prefill(layer, linears, x8))
+print(f"M=8192 qkv-like layer: fp16 path {t16:.2f} ms | bf16 wide {tb:.2f} ms ({t16 / tb:.2f}x)")
+sys.exit(1 if fails else 0)
