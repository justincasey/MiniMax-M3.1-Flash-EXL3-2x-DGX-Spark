-            else:
-                _dense_forward_fp8(linear, x_in, out=dst)
+        if not layer.__dict__.get("_exl3_wide_logged"):
+            layer._exl3_wide_logged = True
+            logger.info("EXL3 %s prefill: %s", "FP8" if fp8 else "bf16", getattr(layer, "prefix", "?"))
         return y
 
     def _apply_impl(self, layer, x: torch.Tensor) -> torch.Tensor:
@@ -7106,7 +7158,7 @@ class Exl3LinearMethod(LinearMethodBase):
         else:
             x_2d = x
 
-        y = self._apply_fp8_layer(layer, linears, x_2d)
+        y = self._apply_wide_prefill(layer, linears, x_2d)
