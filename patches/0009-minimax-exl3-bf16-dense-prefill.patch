+        bf16 = (not fp8) and _EXL3_BF16_PREFILL and rows >= _EXL3_BF16_MIN_ROWS and x_2d.dtype == torch.bfloat16
+        if not (fp8 or bf16):
             return None
-        plan = layer.__dict__.get("_exl3_fp8_plan", False)
-        if plan is False:
-            plan = None
-            sizes = list(layer._exl3_linear_output_partition_sizes)
-            bf16_shards = getattr(layer, "_exl3_linear_bf16_shards", [])
-            indexer_ids = getattr(layer, "_exl3_indexer_shards", ())
-            mxfp8 = getattr(layer, "_exl3_indexer_mxfp8", None)
-            ok = (
-                _fp8_kernels_available()
-                and not (_EXL3_FP8_SKIP is not None and _EXL3_FP8_SKIP.search(str(getattr(layer, "prefix", ""))))
-                and not getattr(layer, "_exl3_linear_padded", False)
-                and len(sizes) == len(linears)
-            )
-            offsets, offset = [], 0
-            for i, linear in enumerate(linears):
-                offsets.append(offset)
-                exl3_shard = not (mxfp8 is not None and i in indexer_ids) and i not in bf16_shards
-                if exl3_shard and (
-                    linear is None
-                    or not _fp8_eligible(linear)
-                    or int(linear.out_features) != int(sizes[i])
-                    or offset % 8
-                ):
-                    ok = False
-                offset += int(sizes[i])
-            if ok:
-                plan = (offsets, offset)
-            layer._exl3_fp8_plan = plan
-            logger.info("EXL3 FP8 prefill %s: %s", "ON" if plan else "off", getattr(layer, "prefix", "?"))
+        plan = self._wide_prefill_plan(layer, linears)
         if plan is None:
             return None
-        offsets, total = plan
+        offsets, total, runs = plan
         x_in = x_2d.contiguous()
         y = torch.empty((rows, total), dtype=x_2d.dtype, device=x_2d.device)
+        sizes = layer._exl3_linear_output_partition_sizes
+        if fp8:
+            exl3_ids = {i for a, b in runs for i in range(a, b)}
+            for i in exl3_ids:
+                _dense_forward_fp8(linears[i], x_in, out=y[:, offsets[i] : offsets[i] + int(sizes[i])])
+        else:
+            ext = load_exllamav3_ext()
+            k = int(x_in.shape[1])
+            for a, b in runs:
+                run_n = sum(int(sizes[i]) for i in range(a, b))
+                wb = torch.empty((k, run_n), dtype=torch.bfloat16, device=x_in.device)
+                col = 0
+                for i in range(a, b):
+                    lin = linears[i]
+                    n = int(sizes[i])
+                    w16 = torch.empty((k, n), dtype=torch.half, device=x_in.device)
+                    ext.reconstruct_had_slice(w16, lin.trellis, lin.suh, lin.svh, lin.K, lin.mcg, lin.mul1, 0)
+                    wb[:, col : col + n].copy_(w16)
+                    del w16
+                    col += n
+                dst = y[:, offsets[a] : offsets[a] + run_n]
+                torch.mm(x_in, wb, out=dst)
+                del wb
+                for i in range(a, b):
