diff --git a/tests/gpu/bench_fat_grouped_shapes.py b/tests/gpu/bench_fat_grouped_shapes.py
new file mode 100644
index 0000000..b463abe
--- /dev/null
+++ b/tests/gpu/bench_fat_grouped_shapes.py
@@ -0,0 +1,47 @@
+"""Grouped fat GEMM at serving-like fat-tier loads (run in the image): ~24 experts x 260-700 rows.
+gate (6144->1536 K2, plain store), down (1536->6144 K2, atomic scatter), down plain store."""
+import time
+import torch
+import vllm_exl3_c as nat
+
+dev = "cuda"
+torch.manual_seed(0)
+counts = torch.randint(260, 700, (24,)).tolist()
+rows = sum(counts)
+starts = [0]
+for n in counts:
+    starts.append(starts[-1] + n)
+bounds = torch.tensor([b for g in range(len(counts)) for b in (starts[g], starts[g + 1])], dtype=torch.int32, device=dev)
+el, eh = torch.empty(0, dtype=torch.long, device=dev), torch.empty(0, dtype=torch.float16, device=dev)
+
+
+def setup(k_in, k_out, K):
+    tr = [torch.randint(-32768, 32767, (k_in // 16, k_out // 16, 16 * K), dtype=torch.int16, device=dev) for _ in counts]
+    sv = [(torch.rand(k_out, device=dev) + 0.5).half() for _ in counts]
+    return (torch.tensor([t.data_ptr() for t in tr], dtype=torch.int64, device=dev),
+            torch.tensor([t.data_ptr() for t in sv], dtype=torch.int64, device=dev), tr, sv)
+
+
+def timeit(fn, n=20):
+    fn(); torch.cuda.synchronize(); t = time.perf_counter()
+    for _ in range(n): fn()
+    torch.cuda.synchronize(); return (time.perf_counter() - t) / n * 1e3
+
+
+g_tp, g_sp, *_keep_g = setup(6144, 1536, 2)
+d_tp, d_sp, *_keep_d = setup(1536, 6144, 2)
+a_g = (torch.randn(rows, 6144, device=dev) * 0.5).half()
+a_d = (torch.randn(rows, 1536, device=dev) * 0.5).half()
+o_g = torch.empty(rows, 1536, dtype=torch.float32, device=dev)
+o_dp = torch.empty(rows, 6144, dtype=torch.float32, device=dev)
+o_ds = torch.zeros(8192, 6144, dtype=torch.float32, device=dev)
+tok = torch.cat([torch.randperm(8192, device=dev)[:n] for n in counts]).long()
+wt = torch.rand(rows, device=dev).half()
+fl = 2 * rows * 6144 * 1536
+for name, fn in (
+    ("gate plain", lambda: nat.exl3_fat_gemm_grouped(a_g, g_tp, o_g, g_sp, bounds, el, eh, 2, False, True, False, 1536, max(counts))),
+    ("down scatter", lambda: nat.exl3_fat_gemm_grouped(a_d, d_tp, o_ds, d_sp, bounds, tok, wt, 2, False, True, True, 6144, max(counts))),
+    ("down plain", lambda: nat.exl3_fat_gemm_grouped(a_d, d_tp, o_dp, d_sp, bounds, el, eh, 2, False, True, False, 6144, max(counts))),
+):
+    ms = timeit(fn)
+    print(f"{name:<13} {rows} rows / {len(counts)} experts: {ms:.2f} ms ({fl / ms / 1e9:.1f} TFLOPS)")
diff --git a/tests/gpu/bench_mixedk_decode.py b/tests/gpu/bench_mixedk_decode.py
new file mode 100644
index 0000000..5a17fe0
--- /dev/null
+++ b/tests/gpu/bench_mixedk_decode.py
@@ -0,0 +1,92 @@
+"""exl3_moe_mixedk at decode shape on the 2.15 lane's per-rank expert geometry (run in the image).
+
+128 experts, hidden 6144, intermediate 1536 (TP2), gate/up K2, down K2 (112) / K3 (16), mul1
+codebook, SwiGLU-OAI. A verify step is 4 rows x top-4. Reports time per launch, the bytes
+of distinct routed experts and the effective bandwidth, for k_max values (instance choice).
+"""
+import sys
+import time
+
+import torch
+from exllamav3.ext import exllamav3_ext as ext
+
+dev = "cuda"
+torch.manual_seed(0)
+H, I, E, TOPK = 6144, 1536, 128, 4
+MOE_ACT_SWIGLU_OAI = 3
+kg = torch.full((E,), 2, dtype=torch.int32)
+ku = torch.full((E,), 2, dtype=torch.int32)
+kd = torch.full((E,), 2, dtype=torch.int32)
+kd[torch.randperm(E)[:16]] = 3
+
+
+def tensors(k_in, k_out, K):
+    tr = torch.randint(-32768, 32767, (k_in // 16, k_out // 16, 16 * K), dtype=torch.int16, device=dev)
+    suh = (torch.where(torch.rand(k_in, device=dev) < 0.5, -1.0, 1.0)).half()
+    svh = (torch.rand(k_out, device=dev) * 0.02 + 0.01).half()
+    return tr, suh, svh
+
+
+experts = []
+for e in range(E):
+    experts.append({"gate": tensors(H, I, int(kg[e])), "up": tensors(H, I, int(ku[e])), "down": tensors(I, H, int(kd[e]))})
+
+
+def ptr(p, i):
+    return torch.tensor([experts[e][p][i].data_ptr() for e in range(E)], dtype=torch.int64, device=dev)
+
+
+P = [ptr(p, i) for p in ("gate", "up", "down") for i in range(3)]
+conc = int(ext.exl3_moe_max_concurrency(0))
+ROWS = 64
+temps = [torch.empty((conc, ROWS, H), dtype=torch.half, device=dev) for _ in range(2)] + \
+        [torch.empty((conc, ROWS, I), dtype=torch.half, device=dev) for _ in range(2)]
+KG, KU, KD = kg.to(dev), ku.to(dev), kd.to(dev)
+expert_bytes = [sum(experts[e][p][0].numel() * 2 for p in ("gate", "up", "down")) for e in range(E)]
+
+
+def run(x, sel, w, k_max):
+    tokens = x.shape[0]
+    flat = sel.reshape(-1)
+    order = flat.argsort(stable=True)
+    token_sorted = torch.arange(tokens, device=dev).repeat_interleave(TOPK)[order]
+    weight_sorted = w.reshape(-1)[order].half()
+    count = torch.zeros(E + 1, dtype=torch.long, device=dev)
+    count.scatter_add_(0, flat.long(), torch.ones_like(flat, dtype=torch.long))
+    out = torch.zeros(tokens, H, dtype=torch.float32, device=dev)
+
+    def go():
+        out.zero_()
+        ext.exl3_moe_mixedk(x, out, count, token_sorted, weight_sorted, *temps, MOE_ACT_SWIGLU_OAI, KG, KU, KD, *P,
+                            False, True, False, True, False, True, 7.0, -1, None, None, 1, ROWS, 16, k_max, None)
+    return go, out
+
+
+for tokens in (1, 4, 8):
+    x = (torch.randn(tokens, H, device=dev) * 0.5).half()
+    sel = torch.stack([torch.randperm(E, device=dev)[:TOPK] for _ in range(tokens)])
+    w = torch.rand(tokens, TOPK, device=dev) * 0.5
+    distinct = torch.unique(sel).tolist()
+    mb = sum(expert_bytes[e] for e in distinct) / 1e6
+    outs = {}
+    for k_max in [int(v) for v in __import__('os').environ.get('KMAX', '3,8').split(',')]:
+        go, out = run(x, sel, w, k_max)
+        go()
+        torch.cuda.synchronize()
+        n = 200
+        t = time.perf_counter()
+        for _ in range(n):
+            go()
+        torch.cuda.synchronize()
+        us = (time.perf_counter() - t) / n * 1e6
+        outs[k_max] = out.clone()
+        print(f"tokens={tokens} distinct experts={len(distinct)} ({mb:.1f} MB): k_max={k_max} {us:7.1f} us "
+              f"-> {mb / us * 1e3:.0f} GB/s")
+    ref_path = f"/tmp/mixedk_ref_t{tokens}.pt"
+    import os
+    if os.environ.get("SAVE_REF"):
+        torch.save(outs[3].cpu(), ref_path)
+    elif os.path.exists(ref_path):
+        ref = torch.load(ref_path).to(dev)
+        print(f"  vs reference run rel {((outs[3] - ref).norm() / ref.norm()).item():.1e}")
+sys.exit(0)
diff --git a/tests/gpu/bench_mixedk_prefill.py b/tests/gpu/bench_mixedk_prefill.py
new file mode 100644
index 0000000..8e88a6f
--- /dev/null
+++ b/tests/gpu/bench_mixedk_prefill.py
@@ -0,0 +1,113 @@
+"""exl3_moe_mixedk at prefill shape: m_tile 16 vs 32 vs 64 (run in the image).
+
+2.15-lane per-rank geometry (128 experts, hidden 6144, intermediate 1536, K2 gate/up, K2/K3
+down, mul1, SwiGLU-OAI). 8192 tokens x top-4 with skewed routing; the launch owns experts
+with 1..256 rows (count band), as in serving where experts above 256 rows take the fat tier.
+Prints time and the max relative difference against m_tile 16.
+"""
+import sys
+import time
+
+import torch
+from exllamav3.ext import exllamav3_ext as ext
+
+dev = "cuda"
+torch.manual_seed(0)
+import os
+H, I, E, TOPK = 6144, 1536, 128, 4
+T = int(os.environ.get("T", "8192"))
+kg = torch.full((E,), 2, dtype=torch.int32)
+ku = torch.full((E,), 2, dtype=torch.int32)
+kd = torch.full((E,), 2, dtype=torch.int32)
+kd[torch.randperm(E)[:16]] = 3
+
+
+def tensors(k_in, k_out, K):
+    tr = torch.randint(-32768, 32767, (k_in // 16, k_out // 16, 16 * K), dtype=torch.int16, device=dev)
+    suh = (torch.where(torch.rand(k_in, device=dev) < 0.5, -1.0, 1.0)).half()
+    svh = (torch.rand(k_out, device=dev) * 0.02 + 0.01).half()
+    return tr, suh, svh
+
+
+experts = [{"gate": tensors(H, I, int(kg[e])), "up": tensors(H, I, int(ku[e])), "down": tensors(I, H, int(kd[e]))}
+           for e in range(E)]
+P = [torch.tensor([experts[e][p][i].data_ptr() for e in range(E)], dtype=torch.int64, device=dev)
+     for p in ("gate", "up", "down") for i in range(3)]
+conc = int(ext.exl3_moe_max_concurrency(0))
+ROWS = 1024
+temps = [torch.empty((conc, ROWS, H), dtype=torch.half, device=dev) for _ in range(2)] + \
+        [torch.empty((conc, ROWS, I), dtype=torch.half, device=dev) for _ in range(2)]
+KG, KU, KD = kg.to(dev), ku.to(dev), kd.to(dev)
+
+# Skewed routing: expert popularity ~ lognormal, so row counts spread over ~20..600.
+pop = torch.distributions.LogNormal(0, 0.8).sample((E,))
+sel = torch.multinomial(pop.repeat(T, 1), TOPK, replacement=False).to(dev)
+x = (torch.randn(T, H, device=dev) * 0.5).half()
+w = (torch.rand(T, TOPK, device=dev) * 0.5).half()
+flat = sel.reshape(-1)
+order = flat.argsort(stable=True)
+token_sorted = torch.arange(T, device=dev).repeat_interleave(TOPK)[order]
+weight_sorted = w.reshape(-1)[order]
+count = torch.zeros(E + 1, dtype=torch.long, device=dev)
+count.scatter_add_(0, flat.long(), torch.ones_like(flat, dtype=torch.long))
+c = count[:E].cpu()
+band = (c >= 1) & (c <= 256)
+print(f"experts in band 1..256: {int(band.sum())}, rows {int(c[band].sum())}, mean {float(c[band].float().mean()):.0f}")
+flops = 2 * 3 * H * I * int(c[band].sum())
+
+res = {}
+for mt in (16, 32, 64):
+    out = torch.zeros(T, H, dtype=torch.float32, device=dev)
+
+    def go():
+        out.zero_()
+        ext.exl3_moe_mixedk(x, out, count, token_sorted, weight_sorted, *temps, 3, KG, KU, KD, *P,
+                            False, True, False, True, False, True, 7.0, -1, None, None, 1, 256, mt, 3, None)
+    go()
+    torch.cuda.synchronize()
+    t = time.perf_counter()
+    for _ in range(10):
+        go()
+    torch.cuda.synchronize()
+    ms = (time.perf_counter() - t) * 100
+    res[mt] = out.clone()
+    extra = ""
+    if mt != 16:
+        extra = f" | rel vs m16 {((res[mt] - res[16]).norm() / res[16].norm()).item():.1e}"
+    print(f"m_tile {mt:2d}: {ms:7.2f} ms ({flops / ms / 1e9:.1f} TFLOPS){extra}")
+
+# fp32 reference over the band experts: fp16 reconstruct (exact trellis values), fp32 GEMMs.
+def had(t, pre=None, post=None):
+    t = t.float().contiguous()
+    ext.had_r_128(t, t, pre, post, 1.0)
+    return t
+
+ref = torch.zeros(T, H, dtype=torch.float32, device=dev)
+starts = torch.cat([torch.zeros(1, dtype=torch.long), count[:E].cpu().cumsum(0)])
+for e in range(E):
+    n = int(c[e])
+    if not (1 <= n <= 256):
+        continue
+    rows = token_sorted[starts[e]:starts[e] + n]
+    wts = weight_sorted[starts[e]:starts[e] + n].float()
+    xe = x.index_select(0, rows)
+    out_e = []
+    for p in ("gate", "up"):
+        tr, suh, svh = experts[e][p]
+        W = torch.empty(H, I, dtype=torch.half, device=dev)
+        ext.reconstruct(W, tr, int(kg[e] if p == "gate" else ku[e]), False, True)
+        xh = had(xe.float() * suh.float())
+        out_e.append(had(xh @ W.float(), None, svh.float().half()))
+    g, u = out_e
+    g = g.clamp(max=7.0)
+    u = u.clamp(min=-7.0, max=7.0)
+    a = g * torch.sigmoid(1.702 * g) * (u + 1.0)
+    tr, suh, svh = experts[e]["down"]
+    W = torch.empty(I, H, dtype=torch.half, device=dev)
+    ext.reconstruct(W, tr, int(kd[e]), False, True)
+    ah = had(a * suh.float())
+    d = had(ah @ W.float(), None, svh.float().half())
+    ref.index_add_(0, rows, d * wts[:, None])
+for mt in (16, 64):
+    print(f"m_tile {mt}: rel vs fp32 reference {((res[mt] - ref).norm() / ref.norm()).item():.2e}")
+sys.exit(0)
-- 
2.51.0

