From ab225eac3318fd6115ca24204995125186d9de59 Mon Sep 17 00:00:00 2001
From: Justin Casey <4348807+justincasey@users.noreply.github.com>
Date: Sun, 25 Oct 2026 00:54:17 -0500
Subject: [PATCH] MoE prefill kernels: 64-row mixed-K tile; grouped fat GEMM at
 two CTAs per SM

- Mixed-K MoE (experts at or below the fat threshold): batches of >= 2048 tokens pass
  m_tile 64 to exl3_moe_mixedk on mul1 packs, so each dequantized weight tile serves up to
  64 rows. Per-rank 2.15 shapes: -15% at 2K tokens, -24% at 8K (-11% in the served 15K
  prefill). Output within 7e-4 of the 16-row tile; both ~6.5e-4 from an fp32 reference.
  VLLM_EXL3_MIXEDK_M64_MIN_TOKENS (0 disables).
- Grouped fat GEMM: __launch_bounds__(256, 2) (131 -> 128 registers, no spill) runs two
  CTAs per SM; the epilogue stores float4 and the scatter uses red.global.add.v4.f32.
  Serving-like fat loads: gate 3.67 -> 3.25 ms, down scatter 5.68 -> 4.38 ms. Bit-equal
  to the per-expert kernels (tests/gpu/test_fat_gemm_grouped.py).
---
 csrc/exl3_fat_gemm.cu                 |  20 +++--
 src/vllm_exl3/exl3.py                 |  30 ++++++-
 src/vllm_exl3/weight_snapshot.py      |   1 +
 tests/gpu/bench_fat_grouped_shapes.py |  47 +++++++++++
 tests/gpu/bench_mixedk_decode.py      |  92 +++++++++++++++++++++
 tests/gpu/bench_mixedk_prefill.py     | 113 ++++++++++++++++++++++++++
 6 files changed, 292 insertions(+), 11 deletions(-)
 create mode 100644 tests/gpu/bench_fat_grouped_shapes.py
 create mode 100644 tests/gpu/bench_mixedk_decode.py
 create mode 100644 tests/gpu/bench_mixedk_prefill.py

diff --git a/csrc/exl3_fat_gemm.cu b/csrc/exl3_fat_gemm.cu
index a007d96..f441ff5 100644
--- a/csrc/exl3_fat_gemm.cu
+++ b/csrc/exl3_fat_gemm.cu
@@ -203,7 +203,7 @@ void exl3_fat_gemm_kernel(
 
 // One 16x16 trellis tile packs 256 weights at K bits: 16 * K int16 words.
 template <int K, int CB, bool scatter>
-__global__ __launch_bounds__(FAT_THREADS)
+__global__ __launch_bounds__(FAT_THREADS, 2)  // two CTAs per SM: 131 -> <=128 registers
 void exl3_fat_gemm_grouped_kernel(
     const half* __restrict__ a,
     const int64_t* __restrict__ packed_ptrs,
@@ -340,22 +340,26 @@ void exl3_fat_gemm_grouped_kernel(
         }
         __syncthreads();
 
-        for (int i = t; i < rows * FAT_TILE_N; i += FAT_THREADS)
+        // Four consecutive columns per thread: float4 stores, and for the scatter one
+        // vector reduction (red.global.add.v4.f32, sm_90+) instead of four scalar atomics.
+        for (int i = t; i < rows * (FAT_TILE_N / 4); i += FAT_THREADS)
         {
-            int row = i / FAT_TILE_N;
-            int col_out = i % FAT_TILE_N;
+            int row = i / (FAT_TILE_N / 4);
+            int col_out = (i % (FAT_TILE_N / 4)) * 4;
             int source_row = m_base + mb * 16 + row;
-            float value = sh_c[i];
+            float4 v = *reinterpret_cast<const float4*>(sh_c + row * FAT_TILE_N + col_out);
             if constexpr (scatter)
             {
                 int64_t destination = token_idx[source_row];
-                value *= __half2float(route_weight[source_row]);
+                float w = __half2float(route_weight[source_row]);
+                float* dst = out + destination * size_n + n_base + col_out;
                 // Experts of one launch can share a token: accumulate atomically.
-                atomicAdd(out + destination * size_n + n_base + col_out, value);
+                asm volatile("red.global.add.v4.f32 [%0], {%1, %2, %3, %4};"
+                             :: "l"(dst), "f"(v.x * w), "f"(v.y * w), "f"(v.z * w), "f"(v.w * w) : "memory");
             }
             else
             {
-                out[source_row * size_n + n_base + col_out] = value;
+                *reinterpret_cast<float4*>(out + static_cast<size_t>(source_row) * size_n + n_base + col_out) = v;
             }
         }
         __syncthreads();
diff --git a/src/vllm_exl3/exl3.py b/src/vllm_exl3/exl3.py
index e4a48d1..125935c 100644
--- a/src/vllm_exl3/exl3.py
+++ b/src/vllm_exl3/exl3.py
@@ -2363,8 +2363,31 @@ def _exl3_moe_temp_rows(temps) -> int:
     return int(TEMP_ROWS_FUSED)
 
 
+# Prefill row tile of the mixed-K MoE kernel. exllamav3 instantiates 32/64-row tiles for the
+# mul1 codebook; the 64-row instance shares each dequantized weight tile across up to 64
+# rows (it drops to 32/16-row tiles per expert as rows run out). Measured on the 2.15 pack's
+# per-rank shapes: -15% at 2K tokens, -24% at 8K, slower below ~1.5K tokens; output within
+# 7e-4 of the 16-row tile, both ~6.5e-4 from an fp32 reference. Batches with at least
+# VLLM_EXL3_MIXEDK_M64_MIN_TOKENS tokens (default 2048; 0 disables) take it.
+_MIXEDK_M64_MIN_TOKENS = int(os.environ.get("VLLM_EXL3_MIXEDK_M64_MIN_TOKENS", "2048"))
+
+
+def _mixedk_m_tile(layer: Any, tokens: int, capturing: bool, temp_rows: int) -> int:
+    flags = getattr(layer, "_exl3_codebook_flags", _MCG_CODEBOOK_FLAGS)
+    mul1 = bool(flags[1])
+    if (
+        _MIXEDK_M64_MIN_TOKENS > 0
+        and not capturing
+        and mul1
+        and tokens >= _MIXEDK_M64_MIN_TOKENS
+        and temp_rows >= 64
+    ):
+        return 64
+    return 16
+
+
 def _exl3_moe_tail(fn, temp_rows: int, n_exp: int, k_max: int | None = None,
-                   expert_order=None) -> tuple:
+                   expert_order=None, m_tile: int = 16) -> tuple:
     """Trailing arguments exllamav3 1.5.0 added to exl3_moe, or () for older bindings.
 
     1.5.0 appended output_scratch and fused_base (fp32 slot scratch plus slot table for
@@ -2382,9 +2405,9 @@ def _exl3_moe_tail(fn, temp_rows: int, n_exp: int, k_max: int | None = None,
         # 03, the K-descending expert order) after m_tile. Passed explicitly because
         # arity alone cannot separate this from the uniform binding's expert_lo/hi.
         if arity is not None and arity >= EXL3_MOE_ARITY_ORDER:
-            return (None, None, 1, int(temp_rows), 16, int(k_max), expert_order)
+            return (None, None, 1, int(temp_rows), int(m_tile), int(k_max), expert_order)
         if arity is not None and arity >= EXL3_MOE_ARITY_KMAX:
-            return (None, None, 1, int(temp_rows), 16, int(k_max))
+            return (None, None, 1, int(temp_rows), int(m_tile), int(k_max))
     if arity is not None and arity >= EXL3_MOE_ARITY_151:
         # expert_lo/expert_hi default to "every expert": the kernel-side filter is
         # a no-op until a caller narrows it (the packed K-group dispatch does).
@@ -3799,6 +3822,7 @@ def apply_exl3_fused_moe(
             n_exp,
             int(getattr(layer, "_exl3_k_max_launch", 8)),
             expert_order,
+            _mixedk_m_tile(layer, tokens, _capturing, _exl3_moe_temp_rows(temps)),
         )
         n_active_mk = -1 if _exl3_moe_accepts_num_active(fn_mk) else None
         if tail and n_active_mk is None:
