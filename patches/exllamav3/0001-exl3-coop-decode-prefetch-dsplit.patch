+// Split-k: a block covers part of an item's k range, the partial outputs summed by the item's
+// last arrival. Chosen per launch on the device from the run count (the grid is sized on the host
+// for the no-duplicates case and can't see the routing); cap = resident blocks of the launch.
+//
+// Down stage: the whole launch splits by the factor minimizing waves per item when its items
+// don't fill one wave, smallest on ties (a token's reduction expects every slot at one factor).
+// forced > 0 (EXL3_MOE_COOP_KSPLIT) overrides
+__device__ __forceinline__ int pick_ksplit(int forced, int items, int cap, int smax)
+{
+    if (forced > 0) return forced;
+    if (items <= 0 || items >= cap) return 1;
+    smax = min(smax, (int) gridDim.x / items);
+    int best = 1, best_waves = 1;              // waves per item: best_waves / best
+    for (int s = 2; s <= smax; ++s)
+    {
+        const int waves = CEIL_DIVIDE(items * s, cap);
+        if (waves * best < best_waves * s)
+        {
+            best = s;
+            best_waves = waves;
+        }
+    }
+    return best;
+}
+
+// Gate/up stage: the items filling whole waves run unsplit (blocks 0..n_full-1 = items, as
+// without a split); the rest, the last partial wave that a few blocks would otherwise drain
+// alone, split cap / n_tail ways so they fill one wave together (block n_full + q * n_tail + j =
+// split q of item n_full + j). Only for launches of up to three waves: past that the tail is a
+// small share and the split measured a net loss. align consecutive items (one (slot, chunk)
+// arrival group) share a factor. forced > 0 splits every item that many ways. Blocks past the
+// split items get an item index past the end. Returns the launch's split factor (1: nothing
+// split)
+__device__ __forceinline__ int split_item(int forced, int items, int cap, int smax, int align, int& item, int& ks, int& ksplit)
+{
+    const int b = blockIdx.x;
+    int n_full = 0;
+    if (forced <= 0)
+    {
+        n_full = items / cap * cap;
+        n_full -= n_full % align;
+    }
+    const int n_tail = items - n_full;
+    const int s = n_tail == 0 ? 1
+                : forced > 0 ? forced
+                : items >= 3 * cap ? 1
+                : max(1, min(min(smax, cap / n_tail), ((int) gridDim.x - n_full) / n_tail));
+    if (b < n_full || s == 1)
+    {
+        item = b;
+        ks = 0;
+        ksplit = 1;
+        return s;
+    }
+    const int t = b - n_full;
+    item = t < n_tail * s ? n_full + t % n_tail : 0x7fffffff;
+    ks = t / n_tail;
+    ksplit = s;
+    return s;
+}
