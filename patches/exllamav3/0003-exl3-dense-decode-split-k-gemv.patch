+#pragma once
+
+// Decode-shaped dense EXL3 matmul (m <= 16 rows), regular launch, no grid-wide barrier:
+//
+//   block (group, ks): 128 output columns (group) x one 128-aligned k range (split ks of ksplit).
+//   Issues its weight prefetch, rotates its k range of every input row into shared memory
+//   (had(x * suh), the same op as exl3_gemm's input transform), runs the coop MoE GEMV tile over
+//   it (4 n-warps x 4 k-warps, fp32-accumulating MMAs, as exl3_gemm's on sm_80+ other than sm_86)
+//   and writes its partial sums (fp32) to the workspace. The last of the ksplit arrivals of a group (completion counter,
+//   reset by that block) adds the partials in split order, applies the output transform
+//   (had(.) * svh, exl3_gemm's) and stores C.
+//
+// Replaces the cooperative GEMM's serial split-k chain (blocks of one column pass partial sums
+// down through a lock, one after the other) and its grid barrier, which bound small decode
+// matmuls to ~20 us whatever their size. Arguments 0..9 are exl3_gemm_kernel's, so graph
+// parameter recording is the same.
+
+#include "exl3_moe_coop_kernel.cuh"
+
+namespace exl3_dgemv_ns {
+
+using namespace exl3_moe_coop_ns;
+
+constexpr int DG_COLS = 128;                    // output columns per block (the wide tile)
+constexpr int DG_MAX_ROWS = 16;
+constexpr int DG_MAX_GROUPS = 4096;             // completion counters (size_n <= 512K)
+constexpr float DG_R_SCALE = 0.088388347648f;   // 1/sqrt(128)
+
+static_assert(tile_cols<true>() == DG_COLS, "wide tile width");
+
+// Dynamic shared memory: the rotated input of the k range (rows x k_range halves), which the
+// cross-warp reduction reuses after the slice loop, then the staging area of staged widths
+__host__ __device__ constexpr int dg_red_bytes(int mr) { return tile_wk<true>() * mr * DG_COLS * 4; }
+__host__ __device__ constexpr int dg_stage_bytes(bool stage) { return stage ? WK * STAGE_WORDS * 4 : 0; }
+__host__ __device__ constexpr int dg_main_bytes(int mr, int rows, int k_range)
+{
+    return rows * k_range * 2 > dg_red_bytes(mr) ? rows * k_range * 2 : dg_red_bytes(mr);
+}
+
+// 2 blocks per SM at 8 rows (64 registers, as the coop kernels). The 16-row form spills at 64
+// (5 bpw: 64 B) and measured slower held there, so it keeps one
+template <int bits, int MR>
+constexpr int dg_min_blocks() { return MR == 8 ? 2 : 1; }
+
+template <int bits, int cb, bool c_fp32, int MR>
+__global__ __launch_bounds__(THREADS, dg_min_blocks<bits, MR>())
+void exl3_dgemv_kernel
+(
+    const half* __restrict__ A,
+    const uint16_t* __restrict__ B,
+    void* __restrict__ C,
+    const int size_m,
+    const int size_k,
+    const int size_n,
+    int* __restrict__ locks,            // unused (exl3_gemm_kernel's argument slot)
+    const half* __restrict__ suh,
+    half* __restrict__ A_had,           // unused: the input transform stays in shared memory
+    const half* __restrict__ svh,
+    const int ksplit,
+    float* __restrict__ ws              // [DG_MAX_GROUPS] counters, then [ksplit][size_m][size_n] partials
+)
+{
+    extern __shared__ uint32_t smem_dyn[];
+    __shared__ int sh_rows[DG_MAX_ROWS];
+    __shared__ int sh_flag;
+
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x % 32;
+    const int ng = size_n / DG_COLS;
+    const int group = blockIdx.x % ng;
+    const int ks = blockIdx.x / ng;
+    const int chunks = size_k / 128;
+    const int c_begin = chunks * ks / ksplit;
+    const int c_end = chunks * (ks + 1) / ksplit;
+    const int nch = c_end - c_begin;
+    const int k_range = nch * 128;
+    const int kr_max = CEIL_DIVIDE(chunks, ksplit) * 128;
+
+    half* sh_A = (half*) smem_dyn;
+    float* sh_red = (float*) smem_dyn;
+    uint32_t* sh_stage = smem_dyn + dg_main_bytes(MR, size_m, kr_max) / 4;
+    int* ctr = (int*) ws + group;
+    float* part = ws + DG_MAX_GROUPS;
+
+    if (threadIdx.x < size_m) sh_rows[threadIdx.x] = threadIdx.x;
+
+    // Input transform of this block's k range, overlapping the weight prefetch
+    auto rotate = [&]
+    {
+        for (int it = warp; it < size_m * nch; it += WK)
+        {
+            const int r = it / nch;
+            const int c = c_begin + it % nch;
+            had_hf_r_128_inner<true, false>
+            (
+                A + (size_t) r * size_k + c * 128,
+                sh_A + r * k_range + (c - c_begin) * 128,
+                suh + c * 128,
+                DG_R_SCALE
+            );
+        }
+    };
+
+    // The tile addresses A by absolute k-slice: shift the base so slice c_begin * 8 lands on
+    // the start of the shared copy
+    const half2* A2 = ((const half2*) sh_A) - (size_t) c_begin * 64;
+    gemv_tile<bits, cb, true, decltype(rotate), MR, true, 0>
+    (
+        (const uint32_t*) B, A2, (size_t) k_range / 2, sh_rows, size_m,
+        part + (size_t) ks * size_m * size_n, size_n, true,
+        c_begin * 8, c_end * 8, size_n / 16, group, sh_red, sh_stage, rotate
+    );
+
+    if (ksplit > 1)
+    {
+        if (!arrive_last(ctr, ksplit, &sh_flag)) return;
+        if (threadIdx.x == 0) *ctr = 0;     // every arrival is in: ready for the next launch
+    }
+
+    // Epilogue: one warp per row, the split partials summed in split order, then the output
+    // transform through shared memory (the tile's reduction area is free now)
+    for (int r = warp; r < size_m; r += WK)
+    {
+        const int col = group * DG_COLS + lane * 4;
+        float v0 = 0.0f, v1 = 0.0f, v2 = 0.0f, v3 = 0.0f;
+        for (int q = 0; q < ksplit; ++q)
+        {
+            float t0, t1, t2, t3;
+            load_f4_cg(part + ((size_t) q * size_m + r) * size_n + col, t0, t1, t2, t3);
+            v0 += t0; v1 += t1; v2 += t2; v3 += t3;
+        }
+        float* buf = sh_red + warp * DG_COLS;
+        *((float4*) (buf + lane * 4)) = make_float4(v0, v1, v2, v3);
+        __syncwarp();
+        if constexpr (c_fp32)
+            had_ff_r_128_inner<false, true>(buf, ((float*) C) + (size_t) r * size_n + group * DG_COLS,
+                                            svh + group * DG_COLS, DG_R_SCALE);
+        else
+            had_fh_r_128_inner<false, true>(buf, ((half*) C) + (size_t) r * size_n + group * DG_COLS,
+                                            svh + group * DG_COLS, DG_R_SCALE);
+    }
+}
+
+}  // namespace exl3_dgemv_ns
