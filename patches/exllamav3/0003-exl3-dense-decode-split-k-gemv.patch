+#pragma once
+
+// Per-K compilation units of the decode dense matmul (exl3_dgemv_kernel.cuh): each
+// exl3_dgemv_inst_k{K}.cu instantiates the kernels of width K for the three codebooks, both
+// output dtypes and both MMA row counts (8: m <= 8, 16: m <= 16)
+
+#define EXL3_DGEMV_INST_DECL(K) \
+    void* exl3_dgemv_kernel_k##K(int cb, bool c_fp32, int mr);
+
+EXL3_DGEMV_INST_DECL(1)
+EXL3_DGEMV_INST_DECL(2)
+EXL3_DGEMV_INST_DECL(3)
+EXL3_DGEMV_INST_DECL(4)
+EXL3_DGEMV_INST_DECL(5)
+EXL3_DGEMV_INST_DECL(6)
+EXL3_DGEMV_INST_DECL(7)
+EXL3_DGEMV_INST_DECL(8)
+
+#undef EXL3_DGEMV_INST_DECL
+
+#define EXL3_DGEMV_INST_CB(K, cb_) \
+    if (cb == cb_) \
+    { \
+        if (mr == 8) return c_fp32 ? (void*) exl3_dgemv_kernel<K, cb_, true, 8> : (void*) exl3_dgemv_kernel<K, cb_, false, 8>; \
+        return c_fp32 ? (void*) exl3_dgemv_kernel<K, cb_, true, 16> : (void*) exl3_dgemv_kernel<K, cb_, false, 16>; \
+    }
+
+#define EXL3_DGEMV_INST_DEF(K) \
+    void* exl3_dgemv_kernel_k##K(int cb, bool c_fp32, int mr) \
+    { \
+        using namespace exl3_dgemv_ns; \
+        EXL3_DGEMV_INST_CB(K, 0) \
+        EXL3_DGEMV_INST_CB(K, 1) \
+        EXL3_DGEMV_INST_CB(K, 2) \
+        return nullptr; \
+    }
diff --git a/exllamav3/exllamav3_ext/quant/exl3_dgemv.cu b/exllamav3/exllamav3_ext/quant/exl3_dgemv.cu
new file mode 100644
index 00000000..336c1c60
--- /dev/null
+++ b/exllamav3/exllamav3_ext/quant/exl3_dgemv.cu
@@ -0,0 +1,252 @@
+#include <cuda_fp16.h>
+#include "exl3_dgemv.cuh"
+
+#include <c10/cuda/CUDAGuard.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <map>
+#include "../util.h"
+#include "../util.cuh"
+#include "exl3_devctx.cuh"
+#include "exl3_dgemv_kernel.cuh"
+#include "comp_units/exl3_dgemv_instances.cuh"
+
+using namespace exl3_dgemv_ns;
+
+// EXL3_DGEMV: 0 = off (exl3_gemm keeps its GEMV / cooperative paths), 1/unset = the envelope
+// below, 2 = every eligible call (testing)
+static int dgemv_env_mode()
+{
+    static int mode = -2;
+    if (mode == -2)
+    {
+        const char* env = std::getenv("EXL3_DGEMV");
+        mode = env ? atoi(env) : 1;
+    }
+    return mode;
+}
+
+// Envelope (measured, GB10, MiniMax-M3.1 TP2 decode shapes k 1536..6144, n 256..6144, K 4/5,
+// cold L2): the cooperative GEMM's fixed cost (grid barrier, serial split-k chain through the
+// column locks, ~15-20 us) is what this kernel removes, so it wins on small matrices: up to 8
+// rows, 1 MB 2.1x, 4.7 MB 1.2x, 5.9 MB 1.1x faster, and within +-5% either way from 12 to 24 MB.
+// At 9..16 rows (16-row MMAs, one block per SM) it wins at 1 MB (1.8x) and loses from 4.7 MB up.
+// Weight bytes (k * n * K / 8) up to EXL3_DGEMV_MAX_KB (rows <= 8) / EXL3_DGEMV_MAX_KB16 take it
+static int64_t dgemv_max_bytes(int mr)
+{
+    static int64_t kb8 = -1, kb16 = -1;
+    if (kb8 < 0)
+    {
+        const char* e8 = std::getenv("EXL3_DGEMV_MAX_KB");
+        const char* e16 = std::getenv("EXL3_DGEMV_MAX_KB16");
+        kb8 = e8 ? atoll(e8) : 8192;
+        kb16 = e16 ? atoll(e16) : 2048;
+    }
+    return (mr == 8 ? kb8 : kb16) * 1024;
+}
+
+// Split-k cost model, in 128-wide k chunks: waves x (chunks per block + a fixed cost of
+// EXL3_DGEMV_OVH chunks: start-up, input transform, epilogue) + RED per split (the last
+// arrival's partial sums)
+static int dgemv_env_ovh()
+{
+    static int ovh = -2;
+    if (ovh == -2)
+    {
+        const char* env = std::getenv("EXL3_DGEMV_OVH");
+        ovh = env ? atoi(env) : 4;
+    }
+    return ovh;
+}
+constexpr float DGEMV_RED = 0.1f;
+
+static void* dgemv_select_kernel(int K, int cb, bool c_fp32, int mr)
+{
+    switch (K)
+    {
+        case 1: return exl3_dgemv_kernel_k1(cb, c_fp32, mr);
+        case 2: return exl3_dgemv_kernel_k2(cb, c_fp32, mr);
+        case 3: return exl3_dgemv_kernel_k3(cb, c_fp32, mr);
+        case 4: return exl3_dgemv_kernel_k4(cb, c_fp32, mr);
+        case 5: return exl3_dgemv_kernel_k5(cb, c_fp32, mr);
+        case 6: return exl3_dgemv_kernel_k6(cb, c_fp32, mr);
+        case 7: return exl3_dgemv_kernel_k7(cb, c_fp32, mr);
+        case 8: return exl3_dgemv_kernel_k8(cb, c_fp32, mr);
+        default: return nullptr;
+    }
+}
+
+// Per-device workspace: DG_MAX_GROUPS completion counters (self-resetting, zero at allocation),
+// then the split-k partials. Allocated once and never reallocated: the pointer is baked into
+// captured CUDA graphs. Calls whose partials don't fit take a smaller split
+constexpr size_t DGEMV_WS_BYTES = 16 * 1024 * 1024;
+constexpr size_t DGEMV_PART_BYTES = DGEMV_WS_BYTES - DG_MAX_GROUPS * sizeof(int);
+
+static float* dgemv_get_ws(int device)
+{
+    static float* ws[MAX_DEVICES] = {};
+    if (!ws[device])
+    {
+        cuda_check(cudaMalloc(&ws[device], DGEMV_WS_BYTES));
+        cuda_check(cudaMemset(ws[device], 0, DGEMV_WS_BYTES));
+    }
+    return ws[device];
+}
+
+// Opt-in shared memory size per kernel (set once) and occupancy per (kernel, smem)
+static int dgemv_occupancy(void* kernel, int smem, int device)
+{
+    static std::map<void*, int> optin[MAX_DEVICES];
+    static std::map<std::pair<void*, int>, int> occ[MAX_DEVICES];
+    auto it = optin[device].find(kernel);
+    if (it == optin[device].end())
+    {
+        int max_optin = 0;
+        cuda_check(cudaDeviceGetAttribute(&max_optin, cudaDevAttrMaxSharedMemoryPerBlockOptin, device));
+        cudaFuncAttributes attr;
+        cuda_check(cudaFuncGetAttributes(&attr, kernel));
+        max_optin -= (int) attr.sharedSizeBytes;
+        cuda_check(cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, max_optin));
+        it = optin[device].emplace(kernel, max_optin).first;
+    }
+    if (smem > it->second) return 0;
+    auto key = std::make_pair(kernel, smem);
+    auto o = occ[device].find(key);
+    if (o != occ[device].end()) return o->second;
+    int blocks = 0;
+    cuda_check(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&blocks, kernel, THREADS, smem));
+    occ[device][key] = blocks;
+    return blocks;
+}
+
+bool exl3_dgemv_try_launch
+(
+    void** gemm_args,
+    int size_m,
+    int size_k,
+    int size_n,
+    int K,
+    int cb,
+    bool c_fp32,
+    bool has_su_sv,
+    int device,
+    cudaStream_t stream,
+    void** launched_kernel,
+    int force_ksplit,
+    int* chosen_ksplit
+)
+{
+    if (!has_su_sv) return false;
+    if (size_m < 1 || size_m > DG_MAX_ROWS) return false;
+    if (size_k % 128 || size_n % DG_COLS) return false;
+    if (size_n / DG_COLS > DG_MAX_GROUPS) return false;
+    if (K < 1 || K > 8) return false;
+    const int mr = size_m <= 8 ? 8 : 16;
+    if (force_ksplit == 0)
+    {
+        const int mode = dgemv_env_mode();
+        if (mode == 0) return false;
+        if (mode == 1 && (int64_t) size_k * size_n * K / 8 > dgemv_max_bytes(mr)) return false;
+    }
+
+    void* kernel = dgemv_select_kernel(K, cb, c_fp32, mr);
+    if (!kernel) return false;
+
+    const int ng = size_n / DG_COLS;
+    const int chunks = size_k / 128;
+    const bool stage = !(K == 2 || K == 4);
+    const int num_sms = DevCtx::instance().get_num_sms(device);
+    const size_t part_row_bytes = (size_t) size_m * size_n * sizeof(float);
+
+    // Split-k factor: lowest modeled cost (see dgemv_env_ovh); smallest on ties
+    int ksplit = 0, smem = 0;
+    float best = 1e30f;
+    const int s_max = MIN(chunks, 64);
+    for (int s = force_ksplit > 0 ? MIN(force_ksplit, chunks) : 1; s <= s_max; ++s)
+    {
+        if ((size_t) s * part_row_bytes > DGEMV_PART_BYTES) break;
+        const int kr = CEIL_DIVIDE(chunks, s) * 128;
+        const int sm = dg_main_bytes(mr, size_m, kr) + dg_stage_bytes(stage);
+        const int occ = dgemv_occupancy(kernel, sm, device);
+        if (occ > 0)
+        {
+            const int waves = CEIL_DIVIDE(ng * s, occ * num_sms);
+            const float est = (float) waves * (float) (kr / 128 + dgemv_env_ovh()) + DGEMV_RED * s;
+            if (est < best)
+            {
+                best = est;
+                ksplit = s;
+                smem = sm;
+            }
+        }
+        if (force_ksplit > 0) break;
+    }
+    if (ksplit == 0) return false;
+
+    float* ws = dgemv_get_ws(device);
+    void* args[12];
+    for (int i = 0; i < 10; ++i) args[i] = gemm_args[i];
+    args[10] = (void*) &ksplit;
+    args[11] = (void*) &ws;
+    cuda_check(cudaLaunchKernel(kernel, dim3(ng * ksplit), dim3(THREADS), args, smem, stream));
+
+    if (launched_kernel) *launched_kernel = kernel;
+    if (chosen_ksplit) *chosen_ksplit = ksplit;
+    return true;
+}
+
+int exl3_dgemv
+(
+    const at::Tensor& A,
+    const at::Tensor& B,
+    at::Tensor& C,
+    const c10::optional<at::Tensor>& suh,
+    const c10::optional<at::Tensor>& A_had,
+    const c10::optional<at::Tensor>& svh,
+    bool mcg,
+    bool mul1,
+    int force_ksplit
+)
+{
+    const at::cuda::OptionalCUDAGuard device_guard(A.device());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+
+    TORCH_CHECK_DIM(B, 3);
+    TORCH_CHECK_SHAPES(A, -1, B, 0, 16);
+    TORCH_CHECK_SHAPES(C, -1, B, 1, 16);
+    TORCH_CHECK_DTYPE(A, kHalf);
