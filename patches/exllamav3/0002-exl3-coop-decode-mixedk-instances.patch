+// Mixed-K instances cover [k_lo, k_lo + 1], k_lo 1..3 (exl3_moe_coop_mk checks the range)
+static MoeCoopKernel moe_coop_kernel_a_mk(int k_lo, int cb, int Hi, bool wide)
+{
+    switch (k_lo)
+    {
+        case 1: return exl3_moe_coop_kernel_a_mk12(cb, Hi, wide);
+        case 2: return exl3_moe_coop_kernel_a_mk23(cb, Hi, wide);
+        default: return exl3_moe_coop_kernel_a_mk34(cb, Hi, wide);
+    }
+}
+
+static MoeCoopKernel moe_coop_kernel_b_mk(int k_lo, int cb, bool wide)
+{
+    switch (k_lo)
+    {
+        case 1: return exl3_moe_coop_kernel_b_mk12(cb, wide);
+        case 2: return exl3_moe_coop_kernel_b_mk23(cb, wide);
+        default: return exl3_moe_coop_kernel_b_mk34(cb, wide);
+    }
+}
