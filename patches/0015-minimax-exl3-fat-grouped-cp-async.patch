+constexpr int FAT_G_KSUB = 2;  // grouped kernel: 16-wide K sub-blocks per pipeline stage
+// Epilogue staging: rows of FAT_TILE_N floats padded to 136 so the fragment stores
+// (float2, eight rows x four column pairs per half-warp) hit distinct banks.
+constexpr int FAT_C_STRIDE = FAT_TILE_N + 8;
+constexpr int FAT_EPI_ROWS = 32;
+
+// Grouped-kernel shared bytes per pipeline stage (A rows plus trellis words), and the depth:
+// five stages where they fit the 48 KiB that keeps two CTAs per SM (K <= 3), four otherwise.
+template <int K>
+constexpr int fat_g_stage_bytes()
+{
+    return FAT_G_KSUB * (FAT_TILE_M * FAT_TILE_K * 2 + FAT_N_BLOCKS * 16 * K * 2);
+}
+template <int K>
+constexpr int fat_g_stages()
+{
+    return 5 * fat_g_stage_bytes<K>() <= 48 * 1024 ? 5 : 4;
+}
