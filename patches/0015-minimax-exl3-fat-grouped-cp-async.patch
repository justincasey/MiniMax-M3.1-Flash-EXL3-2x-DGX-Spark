+}
+
+__device__ __forceinline__ void fat_cp_commit()
+{
+    asm volatile("cp.async.commit_group;\n" ::: "memory");
+}
+
+template <int n>
+__device__ __forceinline__ void fat_cp_wait()
+{
+    asm volatile("cp.async.wait_group %0;\n" :: "n"(n) : "memory");
+}
