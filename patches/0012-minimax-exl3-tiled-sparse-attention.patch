new file mode 100644
index 0000000..9fd05d1
--- /dev/null
+++ b/tests/gpu/test_sparse_attn_tiled.py
@@ -0,0 +1,83 @@
+"""Tiled sparse attention vs vLLM's kernel on short and multi-request prefills (run in the image)."""
+import sys
+import torch
+sys.path.insert(0, "/src/src")
+import vllm.models.minimax_m3.common.ops.sparse_attn as sa
+from vllm_exl3.sparse_attn_tiled import sparse_attn_tiled
+
+dev = "cuda"
+torch.manual_seed(0)
+KVH, H, D, TOPK = 2, 32, 128, 16
+fails = 0
+
+
+def case(lens, prefixes, name):
+    global fails
+    total = sum(lens)
+    seqs = [p + l for p, l in zip(prefixes, lens)]
+    nblk_req = [(s + 127) // 128 for s in seqs]
+    nblk = sum(nblk_req) + 1
+    q = (torch.randn(total, H, D, device=dev) * 0.5).bfloat16()
+    kv = (torch.randn(nblk, KVH, 128, 2 * D, device=dev) * 0.5).bfloat16()
+    maxb = max(nblk_req)
+    bt = torch.zeros(len(lens), maxb, dtype=torch.int32, device=dev)
+    off = 0
+    for b, n in enumerate(nblk_req):
+        bt[b, :n] = torch.arange(off, off + n, dtype=torch.int32)
+        off += n
+    topk = torch.zeros(KVH, total, TOPK, dtype=torch.int32, device=dev)
+    row = 0
+    for b, (l, p) in enumerate(zip(lens, prefixes)):
+        for i in range(l):
+            valid = (p + i + 128) // 128
+            perm = torch.randperm(valid, device=dev)
+            sel = torch.cat([torch.tensor([valid - 1], device=dev), perm[perm != valid - 1]])[:TOPK]
+            sel = torch.cat([sel, torch.full((TOPK - sel.numel(),), 0, device=dev, dtype=sel.dtype)])  # garbage tail like serving
+            topk[:, row, :] = sel.to(torch.int32)
+            row += 1
+    cu = torch.tensor([0] + list(torch.tensor(lens).cumsum(0).tolist()), dtype=torch.int32, device=dev)
+    sl = torch.tensor(seqs, dtype=torch.int32, device=dev)
+    pl = torch.tensor(prefixes, dtype=torch.int32, device=dev)
+    ref = torch.zeros_like(q)
+    sa.minimax_m3_sparse_attn(q, kv, topk, bt, cu, sl, pl, max(lens), KVH, D ** -0.5, ref)
+    out = torch.zeros_like(q)
+    sparse_attn_tiled(q, kv, topk, bt, cu.tolist(), sl, prefixes, KVH, D ** -0.5, out, tile=8, num_warps=8, num_stages=1)
+    torch.cuda.synchronize()
+    # fp32 ground truth over each row's selected, causal keys.
+    exact = torch.zeros(total, H, D, dtype=torch.float32, device=dev)
+    row = 0
+    for b, (l, p) in enumerate(zip(lens, prefixes)):
+        for i in range(l):
+            qa = p + i
+            valid = (qa + 128) // 128
+            blks = topk[:, row, :min(TOPK, valid)].long()
+            for kh in range(KVH):
+                pages = bt[b, blks[kh]].long()
+                kk = kv[pages, kh, :, :D].float().reshape(-1, D)
+                vv = kv[pages, kh, :, D:].float().reshape(-1, D)
+                kpos = (blks[kh][:, None] * 128 + torch.arange(128, device=dev)[None, :]).reshape(-1)
+                qq = q[row, kh * 16:(kh + 1) * 16].float()
+                sc = (qq @ kk.T) * D ** -0.5
+                sc = sc.masked_fill((kpos > qa)[None, :], float("-inf"))
+                exact[row, kh * 16:(kh + 1) * 16] = torch.softmax(sc, dim=-1) @ vv
+            row += 1
+    e_ref = ((ref.float() - exact).norm() / exact.norm()).item()
+    e_out = ((out.float() - exact).norm() / exact.norm()).item()
+    print(f"  vs fp32 exact: vLLM kernel {e_ref:.2e} | tiled {e_out:.2e}")
+    if e_out > 1.2 * e_ref + 1e-4:
+        fails += 1
+        print("  FAIL: tiled is less accurate than vLLM's kernel")
+    row_rel = ((out.float() - ref.float()).norm(dim=(1, 2)) / ref.float().norm(dim=(1, 2)).clamp(min=1e-6))
+    ok = row_rel.max().item() < 1e-2 and torch.isfinite(out).all().item()
+    fails += not ok
+    print(f"{name}: rows {total}, worst row rel {row_rel.max().item():.1e} at row {int(row_rel.argmax())} {'OK' if ok else 'FAIL'}")
+
+
+case([48], [0], "single 48-token prompt")
+case([129], [0], "single 129-token prompt")
+case([5], [0], "5 tokens")
+case([33, 48, 7], [0, 0, 0], "three requests")
+case([100], [300], "100 tokens after 300 prefix")
+case([512], [0], "512 tokens")
+case([256], [1024], "256 tokens after 1024 prefix")
+sys.exit(1 if fails else 0)
