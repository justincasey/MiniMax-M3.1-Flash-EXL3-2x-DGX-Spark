+"""Tiled vs vLLM sparse attention on a captured real topk_idx (run in the image, /cache mounted)."""
+import sys, time
+import torch
+sys.path.insert(0, "/src/src")
+import vllm.models.minimax_m3.common.ops.sparse_attn as sa
+from vllm_exl3.sparse_attn_tiled import sparse_attn_tiled, build_tiles, build_union
+
+dev = "cuda"
+d = torch.load("/cache/topk_dump.pt")
+topk = d["topk_idx"].to(dev).contiguous()
+cu = d["cu"].to(dev); pl = d["prefix"].to(dev); sl = d["seq_lens"].to(dev)
+KVH, Q, TOPK = topk.shape
+cu_l = cu.tolist(); pl_l = pl.tolist()
+print("topk_idx", tuple(topk.shape), "cu", cu_l, "prefix", pl_l, "seq_lens", sl.tolist())
+H, D = 16 * KVH, 128
+seq = int(sl.max())
+nblk = (seq + 127) // 128
+torch.manual_seed(0)
+q = (torch.randn(Q, H, D, device=dev) * 0.5).bfloat16()
+kv = (torch.randn(nblk, KVH, 128, 2 * D, device=dev) * 0.5).bfloat16()
+bt = torch.arange(nblk, dtype=torch.int32, device=dev)[None, :].repeat(len(cu_l) - 1, 1).contiguous()
+scale = D ** -0.5
+
+
+def timeit(fn, n=10):
+    fn(); torch.cuda.synchronize(); t = time.perf_counter()
+    for _ in range(n): fn()
+    torch.cuda.synchronize(); return (time.perf_counter() - t) / n * 1e3
+
+
+ref = torch.empty_like(q)
+orig = lambda: sa.minimax_m3_sparse_attn(q, kv, topk, bt, cu, sl, pl, int(max(cu_l[i+1]-cu_l[i] for i in range(len(cu_l)-1))), KVH, scale, ref)
+orig()
+t0 = timeit(orig)
+print(f"vLLM kernel: {t0:.2f} ms")
+for tile, nw, ns in ((8, 4, 1), (8, 8, 1), (8, 8, 2), (8, 8, 3), (8, 16, 1)):
+    out = torch.empty_like(q)
+    fn = lambda: sparse_attn_tiled(q, kv, topk, bt, cu_l, sl, pl_l, KVH, scale, out, tile=tile, num_warps=nw, num_stages=ns)
+    fn(); torch.cuda.synchronize()
+    rel = ((out.float() - ref.float()).norm() / ref.float().norm()).item()
+    t = timeit(fn)
+    tq = build_tiles(cu_l, pl_l, tile, dev)
+    u = build_union(topk, tq[0], tq[1], tq[3], tile)[1].float().mean().item()
+    print(f"tiled T={tile:2d} warps={nw} stages={ns}: {t:.2f} ms ({t0 / t:.2f}x) mean union {u:.1f} blocks (vs {tile * TOPK} unshared) rel {rel:.1e}")
