diff --git a/src/vllm_exl3/sparse_attn_tiled.py b/src/vllm_exl3/sparse_attn_tiled.py
new file mode 100644
index 0000000..34dffd3
--- /dev/null
+++ b/src/vllm_exl3/sparse_attn_tiled.py
@@ -0,0 +1,193 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+"""Query-tiled MiniMax-M3 prefill block-sparse attention.
+
+vLLM's ``_gqa_sparse_fwd_kernel`` runs one program per (query token, kv head) and loads
+the token's ``topk`` selected 128-token KV blocks; consecutive tokens select mostly the
+same blocks, so every block is re-read from L2 by each token that picked it. This
+kernel takes ``T`` consecutive tokens of one request per program, iterates the sorted
+union of their selected blocks, loads each block once, and masks per token so every
+token attends exactly its own selected blocks (and causally, as the original). The
+math is the original's; only the order in which blocks enter the online softmax differs.
+
+Same contract as ``minimax_m3_sparse_attn`` for an unquantized (bf16/fp16) KV pool:
+``kv_cache`` [num_blocks, num_kv_heads, 128, 2*head_dim], ``topk_idx``
+[num_kv_heads, total_q, topk] logical block ids (only the first
+min(topk, (q_abs + 128) // 128) entries of each row are read, as in the original).
+"""
+
+from __future__ import annotations
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+SPARSE_BLOCK = 128
+_INT_MAX = 2**31 - 1
+
+
+@triton.jit
+def _gqa_sparse_tiled_fwd_kernel(
+    q_ptr,  # [total_q, num_heads, D]
+    kv_ptr,  # [num_blocks, num_kv_heads, 128, 2D]
+    o_ptr,  # [total_q, num_heads, D]
+    bt_ptr,  # [num_reqs, max_blocks]
+    tile_q0_ptr,  # [n_tiles] first query row of the tile
+    tile_n_ptr,  # [n_tiles] rows in the tile (<= T)
+    tile_req_ptr,  # [n_tiles] request index
+    tile_qabs0_ptr,  # [n_tiles] absolute position of the first row
+    seq_len_ptr,  # [num_reqs]
+    union_ptr,  # [num_kv_heads, n_tiles, MAXU] sorted logical block ids (INT_MAX pad)
+    ucount_ptr,  # [num_kv_heads, n_tiles]
+    sel_ptr,  # [num_kv_heads, n_tiles, T, MAXU] int8: row t selected union entry u
+    n_tiles,
+    gqa_group_size,
+    head_dim,
+    sm_scale,
+    stride_qn, stride_qh, stride_qd,
+    stride_kv_blk, stride_kv_h, stride_kv_pos, stride_kv_d,
+    stride_on, stride_oh, stride_od,
+    stride_bt_b,
+    T: tl.constexpr,
+    MAXU: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    pid_t = tl.program_id(0)
+    pid_kh = tl.program_id(1)
+    ROWS: tl.constexpr = T * BLOCK_H
+    q0 = tl.load(tile_q0_ptr + pid_t)
+    nrows = tl.load(tile_n_ptr + pid_t)
+    req = tl.load(tile_req_ptr + pid_t)
+    qabs0 = tl.load(tile_qabs0_ptr + pid_t)
+    seq_len = tl.load(seq_len_ptr + req)
+    ucount = tl.load(ucount_ptr + pid_kh * n_tiles + pid_t)
+    bt_row = bt_ptr + req * stride_bt_b
+
+    r = tl.arange(0, ROWS)
+    t_of_r = r // BLOCK_H
+    h_of_r = r % BLOCK_H
+    off_d = tl.arange(0, BLOCK_D)
+    off_n = tl.arange(0, BLOCK_K)
+    row_ok = (t_of_r < nrows) & (h_of_r < gqa_group_size)
+    d_ok = off_d < head_dim
+    head = pid_kh * gqa_group_size + h_of_r
+    q = tl.load(
+        q_ptr + (q0 + t_of_r)[:, None] * stride_qn + head[:, None] * stride_qh + off_d[None, :] * stride_qd,
+        mask=row_ok[:, None] & d_ok[None, :],
+        other=0.0,
+    )
+    qabs = qabs0 + t_of_r
+    scale_log2e = sm_scale * 1.4426950409
+    m_i = tl.full((ROWS,), float("-inf"), dtype=tl.float32)
+    l_i = tl.zeros((ROWS,), dtype=tl.float32)
+    acc = tl.zeros((ROWS, BLOCK_D), dtype=tl.float32)
+    u_base = union_ptr + (pid_kh * n_tiles + pid_t) * MAXU
+    s_base = sel_ptr + (pid_kh * n_tiles + pid_t) * (T * MAXU)
+    for u in range(ucount):
+        blk = tl.load(u_base + u)
+        page = tl.load(bt_row + blk).to(tl.int64)
+        c = blk * BLOCK_K
+        pos = c + off_n
+        pos_ok = pos < seq_len
+        k = tl.load(
+            kv_ptr + page * stride_kv_blk + pid_kh * stride_kv_h + off_n[None, :] * stride_kv_pos
+            + off_d[:, None] * stride_kv_d,
+            mask=d_ok[:, None] & pos_ok[None, :],
+            other=0.0,
+        )
+        sel = tl.load(s_base + t_of_r * MAXU + u) != 0
+        s = tl.dot(q, k) * scale_log2e
+        keep = sel[:, None] & (qabs[:, None] >= pos[None, :]) & pos_ok[None, :]
+        s = tl.where(keep, s, float("-inf"))
+        m_ij = tl.maximum(m_i, tl.max(s, axis=1))
+        m_safe = tl.where(m_ij == float("-inf"), 0.0, m_ij)
+        p = tl.exp2(s - m_safe[:, None])
+        alpha = tl.exp2(m_i - m_safe)
+        l_i = l_i * alpha + tl.sum(p, axis=1)
+        v = tl.load(
+            kv_ptr + page * stride_kv_blk + pid_kh * stride_kv_h + off_n[:, None] * stride_kv_pos
+            + (head_dim + off_d[None, :]) * stride_kv_d,
+            mask=pos_ok[:, None] & d_ok[None, :],
+            other=0.0,
+        )
+        acc = acc * alpha[:, None] + tl.dot(p.to(v.dtype), v)
+        m_i = m_ij
+    acc = acc / tl.where(l_i > 0, l_i, 1.0)[:, None]
+    tl.store(
+        o_ptr + (q0 + t_of_r)[:, None] * stride_on + head[:, None] * stride_oh + off_d[None, :] * stride_od,
+        acc.to(o_ptr.dtype.element_ty),
+        mask=row_ok[:, None] & d_ok[None, :],
+    )
+
+
+def build_tiles(cu_seqlens_q: list[int], prefix_lens: list[int], tile: int, device):
+    """Tiles of ``tile`` consecutive rows that never cross a request boundary."""
+    q0, n, req, qabs0 = [], [], [], []
+    for b in range(len(cu_seqlens_q) - 1):
+        qs, qe = int(cu_seqlens_q[b]), int(cu_seqlens_q[b + 1])
+        for s in range(qs, qe, tile):
+            q0.append(s)
+            n.append(min(tile, qe - s))
+            req.append(b)
+            qabs0.append(int(prefix_lens[b]) + (s - qs))
+    as_t = lambda xs: torch.tensor(xs, dtype=torch.int32, device=device)
+    return as_t(q0), as_t(n), as_t(req), as_t(qabs0)
+
+
+def build_union(topk_idx: torch.Tensor, tile_q0, tile_n, tile_qabs0, tile: int):
+    """Sorted union of each tile's selected blocks, per kv head, and the per-row selection mask."""
+    kvh, total_q, topk = topk_idx.shape
+    n_tiles = tile_q0.numel()
+    dev = topk_idx.device
+    t = torch.arange(tile, device=dev, dtype=torch.int32)
+    rows = tile_q0[:, None] + t[None, :]  # [n_tiles, T]
+    row_ok = t[None, :] < tile_n[:, None]
+    rows_c = torch.where(row_ok, rows, torch.zeros_like(rows)).long()
+    blocks = topk_idx[:, rows_c.reshape(-1), :].reshape(kvh, n_tiles, tile, topk).to(torch.int64)
+    qabs = (tile_qabs0[:, None] + t[None, :]).long()
+    real_topk = torch.clamp((qabs + SPARSE_BLOCK) // SPARSE_BLOCK, max=topk)  # [n_tiles, T]
+    k_ok = torch.arange(topk, device=dev)[None, None, :] < real_topk[:, :, None]
+    ok = (row_ok[:, :, None] & k_ok)[None].expand(kvh, -1, -1, -1)
+    blocks = torch.where(ok, blocks, torch.full_like(blocks, _INT_MAX))
+    flat, _ = blocks.reshape(kvh, n_tiles, tile * topk).sort(dim=-1)
+    first = torch.ones_like(flat, dtype=torch.bool)
+    first[..., 1:] = flat[..., 1:] != flat[..., :-1]
+    first &= flat != _INT_MAX
+    ucount = first.sum(-1).to(torch.int32)
+    maxu = tile * topk
+    # Unique values to their compacted slots; every other entry goes to a dump column.
+    union = torch.full((kvh, n_tiles, maxu + 1), _INT_MAX, dtype=torch.int64, device=dev)
+    slot = torch.where(first, first.long().cumsum(-1) - 1, torch.full_like(flat, maxu))
+    union.scatter_(-1, slot, flat)
+    union = union[..., :maxu].contiguous()  # sorted, INT_MAX padded
+    blk_flat = blocks.reshape(kvh, n_tiles, tile * topk)
+    idx = torch.searchsorted(union, blk_flat)
+    idx = torch.where(ok.reshape(kvh, n_tiles, tile * topk), idx, torch.full_like(idx, maxu))
+    sel = torch.zeros((kvh, n_tiles, tile, maxu + 1), dtype=torch.int8, device=dev)
+    sel.scatter_(-1, idx.view(kvh, n_tiles, tile, topk), torch.ones_like(idx, dtype=torch.int8).view(kvh, n_tiles, tile, topk))
+    sel = sel[..., :maxu].contiguous()
+    return union.to(torch.int32), ucount, sel
+
+
+def sparse_attn_tiled(
+    q, kv_cache, topk_idx, block_table, cu_seqlens_q: list[int], seq_lens, prefix_lens: list[int],
+    num_kv_heads: int, sm_scale: float, output, tile: int = 4, num_warps: int = 4, num_stages: int = 1,
+):
+    total_q, num_heads, head_dim = q.shape
+    gqa = num_heads // num_kv_heads
+    tile_q0, tile_n, tile_req, tile_qabs0 = build_tiles(cu_seqlens_q, prefix_lens, tile, q.device)
+    union, ucount, sel = build_union(topk_idx, tile_q0, tile_n, tile_qabs0, tile)
+    n_tiles = tile_q0.numel()
+    _gqa_sparse_tiled_fwd_kernel[(n_tiles, num_kv_heads)](
+        q, kv_cache, output, block_table, tile_q0, tile_n, tile_req, tile_qabs0, seq_lens,
+        union, ucount, sel, n_tiles, gqa, head_dim, sm_scale,
+        q.stride(0), q.stride(1), q.stride(2),
+        kv_cache.stride(0), kv_cache.stride(1), kv_cache.stride(2), kv_cache.stride(3),
+        output.stride(0), output.stride(1), output.stride(2),
+        block_table.stride(0),
+        T=tile, MAXU=tile * topk_idx.shape[-1], BLOCK_H=triton.next_power_of_2(gqa),
+        BLOCK_D=triton.next_power_of_2(head_dim), BLOCK_K=SPARSE_BLOCK,
+        num_warps=num_warps, num_stages=num_stages,
+    )
+    return output
