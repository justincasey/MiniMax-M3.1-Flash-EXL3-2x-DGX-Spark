diff --git a/tests/gpu/bench_sparse_attn.py b/tests/gpu/bench_sparse_attn.py
new file mode 100644
index 0000000..1544e2a
--- /dev/null
+++ b/tests/gpu/bench_sparse_attn.py
@@ -0,0 +1,97 @@
+"""vLLM's MiniMax-M3 prefill sparse attention kernel: launch-parameter sweep (run in the image).
+
+Second 8K chunk of a 16K prompt at TP2 shapes (32 q heads, 2 kv heads, head_dim 128, topk 16 of
+128-token blocks), bf16 staged KV like the q4 prefill path. Outputs compared to the default launch."""
+import time
+import torch
+import vllm.models.minimax_m3.common.ops.sparse_attn as sa
+
+dev = "cuda"
+torch.manual_seed(0)
+Q, PREFIX, H, KVH, D, TOPK = 8192, 8192, 32, 2, 128, 16
+seq = PREFIX + Q
+nblk = seq // 128
+q = (torch.randn(Q, H, D, device=dev) * 0.5).bfloat16()
+kv = (torch.randn(nblk, KVH, 128, 2 * D, device=dev) * 0.5).bfloat16()
+bt = torch.arange(nblk, dtype=torch.int32, device=dev)[None, :]
+pos = PREFIX + torch.arange(Q, device=dev)
+valid = (pos + 128) // 128
+# local block + 15 random valid earlier blocks per token per kv head
+r = torch.rand(KVH, Q, nblk, device=dev)
+r = r.masked_fill(torch.arange(nblk, device=dev)[None, None, :] >= valid[None, :, None], -1)
+r[:, torch.arange(Q), valid - 1] = 2.0
+topk = r.topk(TOPK, dim=-1).indices.to(torch.int32).contiguous()
+cu = torch.tensor([0, Q], dtype=torch.int32, device=dev)
+sl = torch.tensor([seq], dtype=torch.int32, device=dev)
+pl = torch.tensor([PREFIX], dtype=torch.int32, device=dev)
+scale = D ** -0.5
+
+
+def launch(out, **kw):
+    sa._gqa_sparse_fwd_kernel[(Q, KVH, 1)](
+        q, kv, out, out, topk, out, bt, cu, cu, sl, pl, KVH, H // KVH, D, TOPK, 1, scale,
+        q.stride(0), q.stride(1), q.stride(2), kv.stride(0), kv.stride(1), kv.stride(2), kv.stride(3),
+        0, 0, 0, 0, topk.stride(0), topk.stride(1), topk.stride(2), out.stride(0), out.stride(1), out.stride(2),
+        bt.stride(0), BLOCK_SIZE_Q=1, BLOCK_SIZE_K=128, USE_FP8=False, KV_SCALE_MODE=0, **kw)
+
+
+def timeit(fn, n=10):
+    fn(); torch.cuda.synchronize(); t = time.perf_counter()
+    for _ in range(n): fn()
+    torch.cuda.synchronize(); return (time.perf_counter() - t) / n * 1e3
+
+
+ref = torch.empty_like(q)
+launch(ref)
+t0 = timeit(lambda: launch(ref))
+print(f"default: {t0:.2f} ms")
+for nw in (2, 4, 8):
+    for ns in (1, 2, 3, 4):
+        out = torch.empty_like(q)
+        try:
+            launch(out, num_warps=nw, num_stages=ns)
+            t = timeit(lambda: launch(out, num_warps=nw, num_stages=ns))
+            rel = ((out.float() - ref.float()).norm() / ref.float().norm()).item()
+            print(f"num_warps={nw} num_stages={ns}: {t:.2f} ms ({t0 / t:.2f}x) rel {rel:.1e}")
+        except Exception as exc:
+            print(f"num_warps={nw} num_stages={ns}: ERR {str(exc)[:80]}")
+
+# Query-tiled kernel (vllm_exl3.sparse_attn_tiled): same inputs, metadata build included.
+import sys
+sys.path.insert(0, "/src/src")
+from vllm_exl3.sparse_attn_tiled import sparse_attn_tiled, build_tiles, build_union
+
+for tile, nw in ((2, 4), (4, 4), (4, 8), (8, 8)):
+    out = torch.empty_like(q)
+    sparse_attn_tiled(q, kv, topk, bt, [0, Q], sl, [PREFIX], KVH, scale, out, tile=tile, num_warps=nw)
+    torch.cuda.synchronize()
+    rel = ((out.float() - ref.float()).norm() / ref.float().norm()).item()
+    worst = ((out.float() - ref.float()).abs().max()).item()
+    t = timeit(lambda: sparse_attn_tiled(q, kv, topk, bt, [0, Q], sl, [PREFIX], KVH, scale, out, tile=tile, num_warps=nw))
+    tq = build_tiles([0, Q], [PREFIX], tile, dev)
+    tm = timeit(lambda: build_union(topk, tq[0], tq[1], tq[3], tile))
+    u = build_union(topk, tq[0], tq[1], tq[3], tile)[1].float().mean().item()
+    print(f"tiled T={tile} warps={nw}: {t:.2f} ms ({t0 / t:.2f}x; metadata {tm:.2f} ms; mean union {u:.1f} blocks) rel {rel:.1e} max|d| {worst:.1e}")
+
+# Prefix-free first chunk (early tokens with fewer valid blocks than topk).
+Q2 = 4096
+q2 = q[:Q2].contiguous()
+pos2 = torch.arange(Q2, device=dev)
+valid2 = (pos2 + 128) // 128
+r2 = torch.rand(KVH, Q2, nblk, device=dev)
+r2 = r2.masked_fill(torch.arange(nblk, device=dev)[None, None, :] >= valid2[None, :, None], -1)
+r2[:, torch.arange(Q2), valid2 - 1] = 2.0
+topk2 = r2.topk(TOPK, dim=-1).indices.to(torch.int32).contiguous()
+cu2 = torch.tensor([0, Q2], dtype=torch.int32, device=dev)
