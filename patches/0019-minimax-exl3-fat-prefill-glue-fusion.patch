+    float act_alpha,
+    int act_kind)
 {
+    static_assert(!(ACT && scatter), "the activation epilogue takes a plain (row-aligned) output");
+    static_assert(FAT_TILE_N == 128, "one output tile is one Hadamard chunk");
     constexpr int STAGES = fat_g_stages<K>();
     constexpr int KSUB = FAT_G_KSUB;
     constexpr int WARPS = FAT_THREADS / 32;
@@ -461,6 +494,30 @@ void exl3_fat_gemm_grouped_kernel(
                 asm volatile("red.global.add.v4.f32 [%0], {%1, %2, %3, %4};"
                              :: "l"(dst), "f"(v.x * w), "f"(v.y * w), "f"(v.z * w), "f"(v.w * w) : "memory");
             }
+            else if constexpr (ACT)
+            {
+                const size_t off = static_cast<size_t>(m_base + mp * 16 + row) * size_n + n_base;
+                const float4 g4 = *reinterpret_cast<const float4*>(act_gate + off + col_out);
+                float gv[4] = {g4.x, g4.y, g4.z, g4.w};
+                float uv[4] = {v.x, v.y, v.z, v.w};
+                half h[4];
+                #pragma unroll
+                for (int i = 0; i < 4; ++i)
+                {
+                    if (act_limit > 0.0f)
+                    {
+                        gv[i] = fminf(gv[i], act_limit);
+                        uv[i] = fminf(fmaxf(uv[i], -act_limit), act_limit);
