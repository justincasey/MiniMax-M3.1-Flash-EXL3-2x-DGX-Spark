+// Gate (and up) input transform of the fat tier, one pass over the tokens. x: [tokens, cols] bf16
+// or fp16; token_rows: int32 [tokens, topk], the output row of each route (-1: none). Writes
+// gate_out[r] (and up_out[r] unless up_out is empty) and, if zero_out is non-empty, zeroes
+// zero_out [tokens, cols] fp32.
+void exl3_had_r_128_token_gate_up(at::Tensor x, at::Tensor token_rows, at::Tensor row_group,
+                                  at::Tensor gate_scale_ptrs, at::Tensor up_scale_ptrs,
+                                  at::Tensor gate_out, at::Tensor up_out, at::Tensor zero_out)
+{
+    const bool bf16 = x.scalar_type() == at::kBFloat16;
+    TORCH_CHECK((bf16 || x.scalar_type() == at::kHalf) && x.is_contiguous() && x.dim() == 2 && x.size(1) % 128 == 0,
