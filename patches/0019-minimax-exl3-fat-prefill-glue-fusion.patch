+// had_hf_r_128_inner<true, false> with the 128-column chunk index explicit (it reads blockIdx.y):
+// lane holds elements 4 lane .. 4 lane + 3 of the chunk; scale is the full half[cols] vector.
+__device__ __forceinline__ void had_h4_pre_scaled_store(
+    half2 v0, half2 v1, const half* __restrict__ scale, int chunk, half* __restrict__ out, float r_scale, int lane)
+{
+    const half4 s = reinterpret_cast<const half4*>(scale)[chunk * 32 + lane];
+    v0 = __hmul2(v0, s.x);
+    v1 = __hmul2(v1, s.y);
+    const float a0 = __low2float(v0), a1 = __high2float(v0), a2 = __low2float(v1), a3 = __high2float(v1);
+    const float s0 = a0 + a1, d0 = a0 - a1, s1 = a2 + a3, d1 = a2 - a3;
+    float h0 = s0 + s1, h1 = d0 + d1, h2 = s0 - s1, h3 = d0 - d1;
+    shuffle_had_f4x32(h0, h1, h2, h3, lane);
+    half4 o;
+    o.x = __floats2half2_rn(h0 * r_scale, h1 * r_scale);
+    o.y = __floats2half2_rn(h2 * r_scale, h3 * r_scale);
+    reinterpret_cast<half4*>(out)[lane] = o;
+}
