+MoE layer in order. KMAP (optional): JSON {"layer,expert,w1|w2|w3": K} (w1 gate, w3 up, w2 down).
+Every routed expert takes the fat tier (VLLM_EXL3_FAT_THRESHOLD_PREFILL=0). Random weights,
+MiniMax-M3.1 TP2 per-rank shapes (hidden 6144, intermediate 1536, mul1, SwiGLU-OAI, limit 7).
+
+mid:  the token pass, then the previous gate/up/act_had/down (the token pass alone)
+prev: x.half(); zeros; grouped input Hadamard for gate and for up (row gather); gate and up GEMMs
+      into fp32; act_had; down scatter (the 7ac4fbc apply_exl3_grouped_fat with its caller's glue)
+new:  apply_exl3_grouped_fat as shipped: token pass (bf16 x read once, gate+up rows, zeroes out);
+      gate GEMM; up GEMM with the activation epilogue; down scatter
+Prints per-layer-summed ms of both, the glue kernels alone, and the max |diff| of the outputs.
+"""
+import glob
+import json
+import os
+import statistics
+
+import torch
+import vllm_exl3_c as nat
+from vllm_exl3.exl3 import MINIMAX_SWIGLU_ALPHA_DEFAULT, MOE_ACT_SWIGLU_OAI, apply_exl3_grouped_fat
+
+dev = "cuda"
+torch.manual_seed(0)
+H, I, E, LIMIT = 6144, 1536, 128, 7.0
+files = sorted(glob.glob(os.environ["ROUTING"]))
+kmap = json.load(open(os.environ["KMAP"])) if os.environ.get("KMAP") else {}
+kmap_layers = sorted({int(k.split(",")[0]) for k in kmap})
+reps = int(os.environ.get("REPS", "5"))
+el, eh = torch.empty(0, dtype=torch.long, device=dev), torch.empty(0, dtype=torch.float16, device=dev)
+
+
+def tr(k_in, k_out, K):
+    return torch.randint(-32768, 32767, (k_in // 16, k_out // 16, 16 * K), dtype=torch.int16, device=dev)
+
+
+W = {(p, K): [tr(*((I, H) if p == "down" else (H, I)), K) for _ in range(E)] for p in ("gate", "up", "down") for K in (2, 3)}
+SV = {p: [(torch.rand(H if p == "down" else I, device=dev) * 0.02 + 0.01).half() for _ in range(E)] for p in ("gate", "up", "down")}
+SU = {p: [torch.where(torch.rand(I if p == "down" else H, device=dev) < 0.5, -1.0, 1.0).half() for _ in range(E)]
+      for p in ("gate", "up", "down")}
+
+
+def timed(fn):
+    fn()
+    ev = [torch.cuda.Event(enable_timing=True) for _ in range(2 * reps)]
+    for r in range(reps):
+        ev[2 * r].record()
+        fn()
+        ev[2 * r + 1].record()
+    torch.cuda.synchronize()
+    return statistics.median(ev[2 * r].elapsed_time(ev[2 * r + 1]) for r in range(reps))
+
+
+tot = {"prev": 0.0, "new": 0.0, "prev glue": 0.0, "new glue": 0.0}
+maxdiff = 0.0
+for li, f in enumerate(files):
+    ids = torch.load(f).long().to(dev)
+    T, topk = ids.shape
+    x = (torch.randn(T, H, device=dev) * 0.5).to(torch.bfloat16)
+    flat = ids.reshape(-1)
+    counts = torch.bincount(flat, minlength=E)[:E].tolist()
+    Kof = {(e, p): (kmap.get(f"{kmap_layers[li]},{e},{w}", 2) if kmap_layers else 2)
+           for e in range(E) for p, w in (("gate", "w1"), ("up", "w3"), ("down", "w2"))}
+    tables = {"shared_suh": False}
+    for p in ("gate", "up", "down"):
+        tables[p] = {
+            "trellis": torch.tensor([W[(p, Kof[(e, p)])][e].data_ptr() for e in range(E)], dtype=torch.int64, device=dev),
+            "svh": torch.tensor([SV[p][e].data_ptr() for e in range(E)], dtype=torch.int64, device=dev),
+            "suh": torch.tensor([SU[p][e].data_ptr() for e in range(E)], dtype=torch.int64, device=dev),
+            "class": [(Kof[(e, p)], False, True) for e in range(E)],
+            "out": H if p == "down" else I,
+        }
+    order = flat.argsort()
+    flat_token = torch.arange(T, device=dev).repeat_interleave(topk)
+    flat_w = (torch.rand(T * topk, device=dev) * 0.5).half()
+    ts, ws = flat_token[order], flat_w[order]
+
+    def new():
+        out = torch.empty(T, H, dtype=torch.float32, device=dev)
+        return apply_exl3_grouped_fat(x, order, ts, ws, counts, tables, LIMIT, 0, out, MOE_ACT_SWIGLU_OAI, zero_out=True)
+
+    # Previous pipeline, launch by launch.
+    fat = [e for e in range(E) if counts[e] > 0]
+    cnt = [counts[e] for e in fat]
+    rows = sum(cnt)
+    starts = [0]
+    for n in cnt:
+        starts.append(starts[-1] + n)
+    tok = ts.contiguous()
+    fat_t = torch.tensor(fat, dtype=torch.long, device=dev)
+    row_group = torch.repeat_interleave(torch.arange(len(fat), dtype=torch.int32, device=dev), torch.tensor(cnt, device=dev))
+
+    def classes(p):
+        cl = {}
+        for gi, e in enumerate(fat):
+            cl.setdefault(tables[p]["class"][e], []).append(gi)
+        res = []
+        for (k, mcg, mul1), members in cl.items():
+            sel = torch.tensor([fat[g] for g in members], dtype=torch.long, device=dev)
+            b = torch.tensor([v for g in members for v in (starts[g], starts[g + 1])], dtype=torch.int32, device=dev)
+            res.append((tables[p]["trellis"][sel], tables[p]["svh"][sel], b, k, mcg, mul1, max(cnt[g] for g in members)))
+        return res
+
+    cls = {p: classes(p) for p in ("gate", "up", "down")}
+    gs, us, ds = (tables[p]["suh"].index_select(0, fat_t) for p in ("gate", "up", "down"))
+    gate_in = torch.empty(rows, H, dtype=torch.float16, device=dev)
+    up_in = torch.empty_like(gate_in)
+    gate_out = torch.empty(rows, I, dtype=torch.float32, device=dev)
+    up_out = torch.empty_like(gate_out)
+    down_in = torch.empty(rows, I, dtype=torch.float16, device=dev)
+
+    def prev_glue_a():
+        xh = x.half()
+        out = torch.zeros(T, H, dtype=torch.float32, device=dev)
+        nat.exl3_had_r_128_grouped(xh, gate_in, row_group, gs, tok)
+        nat.exl3_had_r_128_grouped(xh, up_in, row_group, us, tok)
+        return out
+
+    def prev_act():
+        nat.exl3_act_had_r_128_grouped(gate_out, up_out, down_in, row_group, ds, LIMIT, MINIMAX_SWIGLU_ALPHA_DEFAULT, 1)
+
+    def prev():
+        out = prev_glue_a()
+        for p, a, dst in (("gate", gate_in, gate_out), ("up", up_in, up_out)):
+            for t, s, b, k, mcg, mul1, mr in cls[p]:
+                nat.exl3_fat_gemm_grouped(a, t, dst, s, b, el, eh, k, mcg, mul1, False, I, mr)
+        prev_act()
+        for t, s, b, k, mcg, mul1, mr in cls["down"]:
+            nat.exl3_fat_gemm_grouped(down_in, t, out, s, b, tok, ws, k, mcg, mul1, True, H, mr)
+        return out
+
+    def new_glue():
+        token_rows = torch.full((T * topk,), -1, dtype=torch.int32, device=dev)
+        token_rows.index_copy_(0, order, torch.arange(rows, dtype=torch.int32, device=dev))
+        out = torch.empty(T, H, dtype=torch.float32, device=dev)
+        nat.exl3_had_r_128_token_gate_up(x, token_rows.view(T, topk), row_group, gs, us, gate_in, up_in, out)
+
+    def mid():
+        # Token pass, then the previous gate/up/act_had/down: separates the two changes.
+        token_rows = torch.full((T * topk,), -1, dtype=torch.int32, device=dev)
+        token_rows.index_copy_(0, order, torch.arange(rows, dtype=torch.int32, device=dev))
+        out = torch.empty(T, H, dtype=torch.float32, device=dev)
+        nat.exl3_had_r_128_token_gate_up(x, token_rows.view(T, topk), row_group, gs, us, gate_in, up_in, out)
+        for p, a, dst in (("gate", gate_in, gate_out), ("up", up_in, up_out)):
+            for t, s, b, k, mcg, mul1, mr in cls[p]:
+                nat.exl3_fat_gemm_grouped(a, t, dst, s, b, el, eh, k, mcg, mul1, False, I, mr)
+        prev_act()
+        for t, s, b, k, mcg, mul1, mr in cls["down"]:
+            nat.exl3_fat_gemm_grouped(down_in, t, out, s, b, tok, ws, k, mcg, mul1, True, H, mr)
+        return out
+
+    d = (new() - prev()).abs().max().item()
+    tot["mid"] = tot.get("mid", 0.0) + timed(mid)
+    maxdiff = max(maxdiff, d)
+    tot["prev"] += timed(prev)
+    tot["new"] += timed(new)
+    tot["prev glue"] += timed(prev_glue_a) + timed(prev_act)
+    tot["new glue"] += timed(new_glue)
+print(f"{len(files)} layers: prev {tot['prev']:.1f} ms, token pass only {tot['mid']:.1f} ms, new {tot['new']:.1f} ms "
+      f"(glue only: prev x.half+zeros+2 had+act_had {tot['prev glue']:.1f} ms, new token pass {tot['new glue']:.1f} ms); "
+      f"max |out diff| {maxdiff:.2e}")
