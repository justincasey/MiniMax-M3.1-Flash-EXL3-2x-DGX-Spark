 // Grouped kernel. Warp w owns 16-column N-block w for all 128 rows and dequantizes its
 // trellis tile in registers (each tile once per CTA). A rows and trellis words go
 // global -> shared with cp.async: STAGES buffers of FAT_G_KSUB 16-wide sub-blocks, STAGES - 2
@@ -242,7 +262,12 @@ __device__ __forceinline__ void fat_cp_wait()
 // stage's last sub-block: its MMAs read resident data and issue first, then the next copy and
 // the next stage's first dequant run while they drain. The per-element accumulation order is
 // the plain K order of the per-expert kernel, so outputs match it bit for bit.
-template <int K, int CB, bool scatter>
+// ACT (non-scatter only): instead of storing the fp32 rows, the epilogue finishes the expert MLP's
+// middle step for them, exactly as act_had_r_128_grouped_kernel would on the stored rows: with
+// act_gate's fp32 rows (the gate projection, same row index and width) it clamps, applies the
+// activation, rounds to fp16, pre-scales by the group's act_scale (the down suh) and writes the
+// 128-wide Hadamard into act_out (fp16, same shape). One FAT_TILE_N column tile is one chunk.
+template <int K, int CB, bool scatter, bool ACT = false>
 __global__ __launch_bounds__(FAT_THREADS, 2)
