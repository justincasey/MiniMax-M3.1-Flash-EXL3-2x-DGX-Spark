+// Grouped up projection with the activation epilogue: for every row of the launch, the up rows
+// computed here and gate's fp32 rows (same index, width size_n) give
+// down_in[r] = had128(down_suh[g] * fp16(act(clamp(gate[r]), clamp(up[r])))), exactly what
+// exl3_fat_gemm_grouped into an fp32 up buffer followed by exl3_act_had_r_128_grouped computes.
+void exl3_fat_gemm_grouped_act(
+    at::Tensor a, at::Tensor packed_ptrs, at::Tensor gate, at::Tensor svh_ptrs, at::Tensor row_bounds,
+    int64_t K, bool mcg, bool mul1, int64_t size_n, int64_t max_rows,
+    at::Tensor down_in, at::Tensor down_scale_ptrs, double limit, double alpha, int64_t act)
+{
+    TORCH_CHECK(a.is_cuda() && a.scalar_type() == at::kHalf && a.is_contiguous() && a.dim() == 2,
+                "a must be a contiguous float16 CUDA matrix");
+    TORCH_CHECK(gate.scalar_type() == at::kFloat && gate.is_contiguous() && gate.dim() == 2 &&
+                gate.size(0) == a.size(0) && gate.size(1) == size_n, "gate must be contiguous float32 [rows, size_n]");
+    TORCH_CHECK(down_in.scalar_type() == at::kHalf && down_in.is_contiguous() && down_in.sizes() == gate.sizes(),
+                "down_in must be contiguous float16 like gate");
+    TORCH_CHECK(packed_ptrs.scalar_type() == at::kLong && svh_ptrs.scalar_type() == at::kLong &&
+                down_scale_ptrs.scalar_type() == at::kLong && packed_ptrs.numel() == svh_ptrs.numel() &&
+                down_scale_ptrs.numel() == packed_ptrs.numel(), "pointer tables must be int64 of equal length");
+    TORCH_CHECK(row_bounds.scalar_type() == at::kInt && row_bounds.numel() == 2 * packed_ptrs.numel(),
+                "row_bounds must be int32 [2 * groups] (start, end) pairs");
+    TORCH_CHECK(K >= 1 && K <= 8, "K 1..8");
+    TORCH_CHECK(!(mcg && mul1), "mcg and mul1 are exclusive");
+    TORCH_CHECK(act == 0 || act == 1, "act 0 (SiLU) or 1 (SwiGLU-OAI)");
+    TORCH_CHECK(size_n % FAT_TILE_N == 0 && a.size(1) % (FAT_TILE_K * FAT_G_KSUB) == 0, "size_n % 128, size_k % 32");
+    if (packed_ptrs.numel() == 0 || max_rows <= 0) return;
+    const FatActArgs args{reinterpret_cast<const float*>(gate.data_ptr()), reinterpret_cast<half*>(down_in.data_ptr()),
+                          reinterpret_cast<const int64_t*>(down_scale_ptrs.data_ptr()), static_cast<float>(limit),
+                          static_cast<float>(alpha), static_cast<int>(act)};
+    if (mcg) launch_grouped_cb<1, false, true>(K, a, packed_ptrs, gate, svh_ptrs, row_bounds, at::Tensor(), at::Tensor(), size_n, max_rows, args);
+    else if (mul1) launch_grouped_cb<2, false, true>(K, a, packed_ptrs, gate, svh_ptrs, row_bounds, at::Tensor(), at::Tensor(), size_n, max_rows, args);
+    else launch_grouped_cb<0, false, true>(K, a, packed_ptrs, gate, svh_ptrs, row_bounds, at::Tensor(), at::Tensor(), size_n, max_rows, args);
+}
