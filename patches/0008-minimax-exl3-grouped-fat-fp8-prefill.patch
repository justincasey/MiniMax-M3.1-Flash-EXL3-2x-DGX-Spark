+"""FP8 (e4m3) vs FP16 GEMM throughput and error on GB10 at the 2.15 lane's per-rank prefill shapes.
+
+fp16: torch.matmul (cuBLAS hgemm, fp32 accumulate), the dense prefill path today.
+fp8:  torch._scaled_mm with per-token activation scales and per-channel weight scales,
+      including the activation quantization (amax + cast) in the timing.
+"""
+import time
+
+import torch
+
+dev = "cuda"
+torch.manual_seed(0)
+print(torch.__version__, torch.cuda.get_device_name(), torch.cuda.get_device_capability())
+F8 = torch.float8_e4m3fn
+F8_MAX = torch.finfo(F8).max
+
+
+def timeit(fn, n=20):
+    fn()
+    torch.cuda.synchronize()
+    t = time.perf_counter()
+    for _ in range(n):
+        fn()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - t) / n * 1e3
+
+
+def quant_rows(x):
+    s = x.abs().amax(dim=1, keepdim=True).float().clamp(min=1e-8) / F8_MAX
+    return (x.float() / s).to(F8), s
+
+
+for m in (8192, 16384):
+    for k, n in ((6144, 3072), (3072, 6144), (6144, 12288), (6144, 6144)):
+        a = torch.randn(m, k, device=dev, dtype=torch.float16)
+        w = torch.randn(k, n, device=dev, dtype=torch.float16) * 0.02
+        flops = 2 * m * k * n
+        t16 = timeit(lambda: a @ w)
+        ref = (a @ w).float()
+        wq_t, ws = quant_rows(w.t().contiguous())  # per output channel
+        wq = wq_t.t()  # column-major [k, n]
+
+        def fp8():
+            aq, as_ = quant_rows(a)
+            return torch._scaled_mm(aq, wq, scale_a=as_, scale_b=ws.t(), out_dtype=torch.bfloat16)
+
+        try:
+            t8 = timeit(fp8)
+            aq, as_ = quant_rows(a)
+            t8_mm = timeit(lambda: torch._scaled_mm(aq, wq, scale_a=as_, scale_b=ws.t(), out_dtype=torch.bfloat16))
+            err = ((fp8().float() - ref).norm() / ref.norm()).item()
+            print(f"M={m} {k}->{n}: fp16 {t16:.2f} ms ({flops / t16 / 1e9:.0f} TF) | fp8 {t8:.2f} ms incl quant, "
+                  f"{t8_mm:.2f} ms gemm ({flops / t8_mm / 1e9:.0f} TF) | fp8 rel err {err:.1e}")
+        except Exception as exc:
+            print(f"M={m} {k}->{n}: fp16 {t16:.2f} ms ({flops / t16 / 1e9:.0f} TF) | fp8 FAILED {exc!r}"[:300])
