diff --git a/csrc/exl3_fp8_prefill.cu b/csrc/exl3_fp8_prefill.cu
new file mode 100644
index 0000000..b9b2b0b
--- /dev/null
+++ b/csrc/exl3_fp8_prefill.cu
@@ -0,0 +1,247 @@
+// FP8 (e4m3) prefill path for dense EXL3 linears.
+//
+// LinearEXL3 computes y = had(had(x * suh) @ W) * svh, where W is the bare trellis
+// codebook matrix. The FP8 path keeps that rotated basis, because the input Hadamard
+// spreads activation outliers across the 128-wide block, so a per-row FP8 scale
+// fits well:
+//   1. exl3_had_quant_fp8_rows: xh = had(x * suh) per row (x fp16 or bf16), amax, xq = xh / s_row.
+//   2. exl3_fp16_to_fp8_t:      Wq^T = (W / s_w)^T in e4m3 ([N, K], column-major B).
+//   3. torch._scaled_mm(xq, Wq^T.t(), tensorwise scales) -> bf16 [M, N].
+//   4. exl3_had_rows_bf16:      y = had(acc * s_row * s_w) * svh, written fp32/bf16/fp16
+//                               into a (possibly column-sliced) output.
+// Tensorwise scaling in step 3 keeps cuBLASLt on its fast FP8 kernels on GB10;
+// rowwise scaling there selects a kernel ~3x slower at N >= 6144.
+
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+#include <c10/cuda/CUDAGuard.h>
+#include <ATen/cuda/CUDAContext.h>
+
+#include "util.h"
+#include "util.cuh"
+#include "hadamard_inner.cuh"
+#include "exl3_fp8_prefill.cuh"
+
+namespace {
+
+constexpr float FP8_MAX = 448.0f;
+constexpr float HAD_R_SCALE = 0.088388347648f;  // 1 / sqrt(128)
+constexpr int QUANT_WARPS = 8;
+constexpr int QUANT_MAX_CHUNKS = 16;  // per warp: K <= 8 * 16 * 128 = 16384
+
+__device__ inline void had4x32(float& h0, float& h1, float& h2, float& h3, int lane)
+{
+    float s0 = h0 + h1, d0 = h0 - h1, s1 = h2 + h3, d1 = h2 - h3;
+    h0 = s0 + s1;
+    h1 = d0 + d1;
+    h2 = s0 - s1;
+    h3 = d0 - d1;
+    shuffle_had_f4x32(h0, h1, h2, h3, lane);
+}
+
+__device__ inline float2 load2(const half* p) { return __half22float2(*reinterpret_cast<const half2*>(p)); }
+__device__ inline float2 load2(const __nv_bfloat16* p)
+{
+    return __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(p));
+}
+
+// One block per row. Warp w owns the 128-wide chunks w, w + 8, ...
+template <typename TIn>
+__global__ __launch_bounds__(QUANT_WARPS * 32)
+void had_quant_fp8_rows_kernel(
+    const TIn* __restrict__ x,
+    const half* __restrict__ suh,
+    __nv_fp8_e4m3* __restrict__ out,
+    float* __restrict__ row_scale,
+    int cols)
+{
+    __shared__ float warp_max[QUANT_WARPS];
+    const int warp = threadIdx.x / 32;
+    const int lane = threadIdx.x & 31;
+    const int chunks = cols / 128;
+    const size_t row_off = static_cast<size_t>(blockIdx.x) * cols;
+    float v[QUANT_MAX_CHUNKS][4];
+    float amax = 0.0f;
+
+    #pragma unroll
+    for (int c = 0; c < QUANT_MAX_CHUNKS; ++c)
+    {
+        const int chunk = warp + c * QUANT_WARPS;
+        if (chunk < chunks)
+        {
+            const int col = chunk * 128 + lane * 4;
+            const float2 x01 = load2(x + row_off + col), x23 = load2(x + row_off + col + 2);
+            const float2 s01 = load2(suh + col), s23 = load2(suh + col + 2);
+            float h0 = x01.x * s01.x, h1 = x01.y * s01.y, h2 = x23.x * s23.x, h3 = x23.y * s23.y;
+            had4x32(h0, h1, h2, h3, lane);
+            v[c][0] = h0 * HAD_R_SCALE;
+            v[c][1] = h1 * HAD_R_SCALE;
+            v[c][2] = h2 * HAD_R_SCALE;
+            v[c][3] = h3 * HAD_R_SCALE;
+            amax = fmaxf(amax, fmaxf(fmaxf(fabsf(v[c][0]), fabsf(v[c][1])), fmaxf(fabsf(v[c][2]), fabsf(v[c][3]))));
+        }
+    }
+    #pragma unroll
+    for (int o = 16; o > 0; o >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffff, amax, o));
+    if (lane == 0) warp_max[warp] = amax;
+    __syncthreads();
+    amax = warp_max[0];
+    #pragma unroll
+    for (int w = 1; w < QUANT_WARPS; ++w) amax = fmaxf(amax, warp_max[w]);
+    const float scale = fmaxf(amax, 1e-12f) / FP8_MAX;
+    const float inv = 1.0f / scale;
+    if (threadIdx.x == 0) row_scale[blockIdx.x] = scale;
+
+    #pragma unroll
+    for (int c = 0; c < QUANT_MAX_CHUNKS; ++c)
+    {
+        const int chunk = warp + c * QUANT_WARPS;
+        if (chunk < chunks)
+        {
+            const int col = chunk * 128 + lane * 4;
+            __nv_fp8x4_e4m3 q(make_float4(v[c][0] * inv, v[c][1] * inv, v[c][2] * inv, v[c][3] * inv));
+            *reinterpret_cast<__nv_fp8x4_e4m3*>(out + row_off + col) = q;
+        }
+    }
+}
+
+// [K, N] fp16 -> [N, K] e4m3 of w * inv_scale, through a 32x32 shared tile.
+__global__ __launch_bounds__(256)
+void fp16_to_fp8_t_kernel(
+    const half* __restrict__ w,
+    __nv_fp8_e4m3* __restrict__ out,
+    int size_k,
+    int size_n,
+    float inv_scale)
+{
+    __shared__ float tile[32][33];
+    const int n0 = blockIdx.x * 32, k0 = blockIdx.y * 32;
+    const int tx = threadIdx.x & 31, ty = threadIdx.x / 32;
+    #pragma unroll
+    for (int i = ty; i < 32; i += 8)
+        tile[i][tx] = __half2float(w[static_cast<size_t>(k0 + i) * size_n + n0 + tx]);
+    __syncthreads();
+    #pragma unroll
+    for (int i = ty; i < 32; i += 8)
+        out[static_cast<size_t>(n0 + i) * size_k + k0 + tx] = __nv_fp8_e4m3(tile[tx][i] * inv_scale);
+}
+
+__device__ inline void store4(float* p, float a, float b, float c, float d) { *reinterpret_cast<float4*>(p) = make_float4(a, b, c, d); }
+__device__ inline void store4(__nv_bfloat16* p, float a, float b, float c, float d)
+{
+    reinterpret_cast<__nv_bfloat162*>(p)[0] = __floats2bfloat162_rn(a, b);
+    reinterpret_cast<__nv_bfloat162*>(p)[1] = __floats2bfloat162_rn(c, d);
+}
+__device__ inline void store4(half* p, float a, float b, float c, float d)
+{
+    reinterpret_cast<half2*>(p)[0] = __floats2half2_rn(a, b);
+    reinterpret_cast<half2*>(p)[1] = __floats2half2_rn(c, d);
+}
+
+// y = had(acc * row_scale * w_scale) * svh, bf16 in. Grid (rows, cols / 128), one warp.
+// ``out`` rows are ``out_ld`` elements apart (a column slice of a wider output).
+template <typename TOut>
+__global__ __launch_bounds__(32)
+void had_rows_bf16_kernel(
+    const __nv_bfloat16* __restrict__ acc,
+    const float* __restrict__ row_scale,
+    const half* __restrict__ svh,
+    TOut* __restrict__ out,
+    int64_t out_ld,
+    float w_scale)
+{
+    const int lane = threadIdx.x;
+    const int col = blockIdx.y * 128 + lane * 4;
+    const size_t off = static_cast<size_t>(gridDim.y) * 128 * blockIdx.x + col;
+    const __nv_bfloat162* ap = reinterpret_cast<const __nv_bfloat162*>(acc + off);
+    float2 a = __bfloat1622float2(ap[0]);
+    float2 b = __bfloat1622float2(ap[1]);
+    float h0 = a.x, h1 = a.y, h2 = b.x, h3 = b.y;
+    had4x32(h0, h1, h2, h3, lane);
+    const float s = row_scale[blockIdx.x] * w_scale * HAD_R_SCALE;
+    const half2* sp = reinterpret_cast<const half2*>(svh + col);
+    float2 s01 = __half22float2(sp[0]);
+    float2 s23 = __half22float2(sp[1]);
+    store4(out + static_cast<size_t>(blockIdx.x) * out_ld + col, h0 * s * s01.x, h1 * s * s01.y, h2 * s * s23.x,
+           h3 * s * s23.y);
+}
+
+}  // namespace
+
+void exl3_had_quant_fp8_rows(at::Tensor x, at::Tensor suh, at::Tensor out, at::Tensor row_scale)
+{
+    TORCH_CHECK((x.scalar_type() == at::kHalf || x.scalar_type() == at::kBFloat16) && x.is_contiguous() && x.dim() == 2,
+                "x contiguous float16/bfloat16 [M, K]");
+    const int64_t cols = x.size(1);
+    TORCH_CHECK(cols % 128 == 0 && cols <= QUANT_WARPS * QUANT_MAX_CHUNKS * 128, "K % 128 == 0 and K <= 16384");
+    TORCH_CHECK(suh.scalar_type() == at::kHalf && suh.numel() == cols, "suh float16 [K]");
+    TORCH_CHECK(out.scalar_type() == at::kFloat8_e4m3fn && out.is_contiguous() && out.sizes() == x.sizes(),
+                "out contiguous float8_e4m3fn like x");
+    TORCH_CHECK(row_scale.scalar_type() == at::kFloat && row_scale.numel() == x.size(0), "row_scale float32 [M]");
+    if (x.size(0) == 0) return;
+    const at::cuda::OptionalCUDAGuard device_guard(x.device());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+    const int grid = static_cast<int>(x.size(0));
+    if (x.scalar_type() == at::kHalf)
+        had_quant_fp8_rows_kernel<half><<<grid, QUANT_WARPS * 32, 0, stream>>>(
+            reinterpret_cast<const half*>(x.data_ptr()), reinterpret_cast<const half*>(suh.data_ptr()),
+            reinterpret_cast<__nv_fp8_e4m3*>(out.data_ptr()), row_scale.data_ptr<float>(), static_cast<int>(cols));
+    else
+        had_quant_fp8_rows_kernel<__nv_bfloat16><<<grid, QUANT_WARPS * 32, 0, stream>>>(
+            reinterpret_cast<const __nv_bfloat16*>(x.data_ptr()), reinterpret_cast<const half*>(suh.data_ptr()),
+            reinterpret_cast<__nv_fp8_e4m3*>(out.data_ptr()), row_scale.data_ptr<float>(), static_cast<int>(cols));
+    cuda_check(cudaPeekAtLastError());
+}
+
+void exl3_fp16_to_fp8_t(at::Tensor w, at::Tensor out, double inv_scale)
+{
+    TORCH_CHECK(w.scalar_type() == at::kHalf && w.is_contiguous() && w.dim() == 2, "w contiguous float16 [K, N]");
+    TORCH_CHECK(w.size(0) % 32 == 0 && w.size(1) % 32 == 0, "K, N % 32");
+    TORCH_CHECK(out.scalar_type() == at::kFloat8_e4m3fn && out.is_contiguous() && out.size(0) == w.size(1) &&
+                out.size(1) == w.size(0), "out contiguous float8_e4m3fn [N, K]");
+    const at::cuda::OptionalCUDAGuard device_guard(w.device());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+    dim3 grid(static_cast<int>(w.size(1) / 32), static_cast<int>(w.size(0) / 32));
+    fp16_to_fp8_t_kernel<<<grid, 256, 0, stream>>>(
+        reinterpret_cast<const half*>(w.data_ptr()), reinterpret_cast<__nv_fp8_e4m3*>(out.data_ptr()),
+        static_cast<int>(w.size(0)), static_cast<int>(w.size(1)), static_cast<float>(inv_scale));
+    cuda_check(cudaPeekAtLastError());
+}
+
+void exl3_had_rows_bf16(at::Tensor acc, at::Tensor row_scale, at::Tensor svh, at::Tensor out, double w_scale)
+{
+    TORCH_CHECK(acc.scalar_type() == at::kBFloat16 && acc.is_contiguous() && acc.dim() == 2 && acc.size(1) % 128 == 0,
+                "acc contiguous bfloat16 [M, 128*n]");
+    TORCH_CHECK(out.dim() == 2 && out.size(0) == acc.size(0) && out.size(1) == acc.size(1) && out.stride(1) == 1 &&
+                (out.stride(0) * out.element_size()) % 16 == 0 &&
+                reinterpret_cast<uintptr_t>(out.data_ptr()) % 16 == 0,
+                "out [M, N] with unit column stride and 16-byte aligned rows (may be a column slice)");
+    TORCH_CHECK(row_scale.scalar_type() == at::kFloat && row_scale.numel() == acc.size(0), "row_scale float32 [M]");
+    TORCH_CHECK(svh.scalar_type() == at::kHalf && svh.numel() == acc.size(1), "svh float16 [N]");
+    if (acc.size(0) == 0) return;
+    const at::cuda::OptionalCUDAGuard device_guard(acc.device());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+    dim3 grid(static_cast<int>(acc.size(0)), static_cast<int>(acc.size(1) / 128));
+    const auto* a = reinterpret_cast<const __nv_bfloat16*>(acc.data_ptr());
+    const auto* sv = reinterpret_cast<const half*>(svh.data_ptr());
+    const float* rs = row_scale.data_ptr<float>();
+    const int64_t ld = out.stride(0);
+    const float ws = static_cast<float>(w_scale);
+    switch (out.scalar_type())
+    {
+        case at::kFloat:
+            had_rows_bf16_kernel<float><<<grid, 32, 0, stream>>>(a, rs, sv, out.data_ptr<float>(), ld, ws);
+            break;
+        case at::kBFloat16:
+            had_rows_bf16_kernel<__nv_bfloat16><<<grid, 32, 0, stream>>>(
+                a, rs, sv, reinterpret_cast<__nv_bfloat16*>(out.data_ptr()), ld, ws);
+            break;
+        case at::kHalf:
+            had_rows_bf16_kernel<half><<<grid, 32, 0, stream>>>(a, rs, sv, reinterpret_cast<half*>(out.data_ptr()), ld, ws);
+            break;
+        default:
+            TORCH_CHECK(false, "out must be float32, bfloat16 or float16");
+    }
+    cuda_check(cudaPeekAtLastError());
+}
