+// One 16x16 trellis tile packs 256 weights at K bits: 16 * K int16 words.
+template <int K, int CB, bool scatter>
+__global__ __launch_bounds__(FAT_THREADS)
+void exl3_fat_gemm_grouped_kernel(
+    const half* __restrict__ a,
+    const int64_t* __restrict__ packed_ptrs,
+    float* __restrict__ out,
+    const int64_t* __restrict__ svh_ptrs,
+    const int* __restrict__ row_bounds,
+    const int64_t* __restrict__ token_idx,
+    const half* __restrict__ route_weight,
+    int size_k,
+    int size_n)
+{
+    constexpr int FAT_PACKED_WORDS = 16 * K;
+    extern __shared__ unsigned char shared_raw[];
+    half* sh_a = reinterpret_cast<half*>(shared_raw);
+    uint16_t* sh_b = reinterpret_cast<uint16_t*>(sh_a + FAT_K_SUB * FAT_TILE_M * FAT_TILE_K);
+    float* sh_c = reinterpret_cast<float*>(sh_b + FAT_K_SUB * FAT_N_BLOCKS * FAT_PACKED_WORDS);
+
+    int t = threadIdx.x;
+    int warp = t / 32;
+    int lane = t & 31;
+    // Grouped: blockIdx.z selects the expert; its rows are [row_bounds[2z], row_bounds[2z + 1])
+    // of the shared, expert-sorted ``a`` and its trellis/svh come from the pointer tables.
+    const int g = blockIdx.z;
+    const int size_m = row_bounds[2 * g + 1];
+    int m_base = row_bounds[2 * g] + blockIdx.y * FAT_TILE_M;
+    if (m_base >= size_m) return;
+    const uint16_t* __restrict__ packed = reinterpret_cast<const uint16_t*>(packed_ptrs[g]);
+    const half* __restrict__ svh = reinterpret_cast<const half*>(svh_ptrs[g]);
+    int n_base = blockIdx.x * FAT_TILE_N;
+    int tiles_n = size_n / 16;
+
+    FragC frag_c[FAT_M_BLOCKS][2];
+    #pragma unroll
+    for (int mb = 0; mb < FAT_M_BLOCKS; ++mb)
+    {
+        frag_c[mb][0] = {};
+        frag_c[mb][1] = {};
+    }
+
+    // Stages of FAT_K_SUB 16-wide sub-blocks; the next stage's A/B words are held in
+    // registers (loads in flight) while this stage's MMAs run.
+    const int a_row = t / 2;
+    const int a_col8 = t & 1;
+    const int a_dst_col8 = a_col8 ^ ((a_row >> 2) & 1);
+    const bool a_valid = m_base + a_row < size_m;
+    const half* a_row_ptr = a + static_cast<size_t>(m_base + a_row) * size_k;
+    int4 reg_a[FAT_K_SUB];
+    int4 reg_b[FAT_K_SUB];
+    auto load_stage = [&](int stage) {
+        #pragma unroll
+        for (int sub = 0; sub < FAT_K_SUB; ++sub)
+        {
+            const int k_block = stage * FAT_K_SUB + sub;
+            reg_a[sub] = a_valid
+                ? reinterpret_cast<const int4*>(a_row_ptr + k_block * FAT_TILE_K)[a_col8]
+                : int4{};
+            if (t < 16 * K)
+                reg_b[sub] = reinterpret_cast<const int4*>(
+                    packed + (static_cast<size_t>(k_block) * tiles_n + n_base / 16) * FAT_PACKED_WORDS)[t];
+        }
+    };
+    const int stages = size_k / (FAT_TILE_K * FAT_K_SUB);
+    load_stage(0);
+    for (int stage = 0; stage < stages; ++stage)
+    {
+        #pragma unroll
+        for (int sub = 0; sub < FAT_K_SUB; ++sub)
+        {
+            reinterpret_cast<int4*>(sh_a + sub * FAT_TILE_M * FAT_TILE_K)[a_row * 2 + a_dst_col8] = reg_a[sub];
+            if (t < 16 * K)
+                reinterpret_cast<int4*>(sh_b + sub * FAT_N_BLOCKS * FAT_PACKED_WORDS)[t] = reg_b[sub];
+        }
+        __syncthreads();
+        if (stage + 1 < stages) load_stage(stage + 1);
+
+        #pragma unroll
+        for (int sub = 0; sub < FAT_K_SUB; ++sub)
+        {
+            FragB frag_b0;
+            FragB frag_b1;
+            const uint32_t* warp_b = reinterpret_cast<const uint32_t*>(
+                sh_b + sub * FAT_N_BLOCKS * FAT_PACKED_WORDS + warp * FAT_PACKED_WORDS);
+            dq_dispatch<K, CB>(warp_b, lane << 3, frag_b0, frag_b1);
+            const int4* sub_a = reinterpret_cast<const int4*>(sh_a + sub * FAT_TILE_M * FAT_TILE_K);
+
+            #pragma unroll
+            for (int mb = 0; mb < FAT_M_BLOCKS; ++mb)
+            {
+                FragA frag_a;
+                int row = (lane % 8) + 8 * ((lane / 8) % 2) + mb * 16;
+                int base_col = lane / 16;
+                int swizzled_col = base_col ^ ((row >> 2) & 1);
+                ldsm4(frag_a, const_cast<int4*>(sub_a) + row * 2 + swizzled_col);
+                ptx_mma_m16n8k16(frag_a, frag_b0, frag_c[mb][0]);
+                ptx_mma_m16n8k16(frag_a, frag_b1, frag_c[mb][1]);
+            }
+        }
+        __syncthreads();
+    }
+
+    #pragma unroll
+    for (int mb = 0; mb < FAT_M_BLOCKS; ++mb)
+    {
+        int rows = min(16, size_m - (m_base + mb * 16));
+        if (rows <= 0) break;
+        int row0 = lane / 4;
+        int row1 = row0 + 8;
+        int col = (lane % 4) * 2;
+        int n0 = warp * 16;
+        if (row0 < rows)
+        {
+            float* dst0 = sh_c + row0 * FAT_TILE_N + n0 + col;
+            dst0[0] = frag_c[mb][0][0];
+            dst0[1] = frag_c[mb][0][1];
+            dst0[8] = frag_c[mb][1][0];
+            dst0[9] = frag_c[mb][1][1];
+        }
+        if (row1 < rows)
+        {
+            float* dst1 = sh_c + row1 * FAT_TILE_N + n0 + col;
+            dst1[0] = frag_c[mb][0][2];
+            dst1[1] = frag_c[mb][0][3];
+            dst1[8] = frag_c[mb][1][2];
+            dst1[9] = frag_c[mb][1][3];
+        }
+        __syncthreads();
+
+        for (int row = warp; row < rows; row += 8)
+        {
+            fat_had_ff_128(
+                sh_c + row * FAT_TILE_N,
+                sh_c + row * FAT_TILE_N,
+                svh + n_base);
+        }
+        __syncthreads();
+
+        for (int i = t; i < rows * FAT_TILE_N; i += FAT_THREADS)
+        {
+            int row = i / FAT_TILE_N;
+            int col_out = i % FAT_TILE_N;
+            int source_row = m_base + mb * 16 + row;
+            float value = sh_c[i];
+            if constexpr (scatter)
+            {
+                int64_t destination = token_idx[source_row];
+                value *= __half2float(route_weight[source_row]);
+                // Experts of one launch can share a token: accumulate atomically.
+                atomicAdd(out + destination * size_n + n_base + col_out, value);
+            }
+            else
+            {
+                out[source_row * size_n + n_base + col_out] = value;
+            }
+        }
+        __syncthreads();
+    }
+}
+
+
+// Grouped pre-scaled Hadamard over expert-sorted rows: row r uses the half[cols]
+// scale vector scale_ptrs[row_group[r]] (exllamav3 had_r_128 with pre_scale).
+// With ``gather`` set, output row r reads input row gather[r] (fused index_select).
+__global__ __launch_bounds__(32)
+void had_hf_r_128_grouped_kernel(
+    const half* __restrict__ input_ptr,
+    half* __restrict__ output_ptr,
+    const int* __restrict__ row_group,
+    const int64_t* __restrict__ scale_ptrs,
+    const int64_t* __restrict__ gather,
+    const float r_scale)
+{
+    const half* scale = reinterpret_cast<const half*>(scale_ptrs[row_group[blockIdx.x]]);
+    const size_t src_row = gather ? static_cast<size_t>(gather[blockIdx.x]) : blockIdx.x;
+    input_ptr += (size_t) gridDim.y * 128 * src_row + blockIdx.y * 128;
+    output_ptr += (size_t) gridDim.y * 128 * blockIdx.x + blockIdx.y * 128;
+    had_hf_r_128_inner<true, false>(input_ptr, output_ptr, scale, r_scale);
+}
+
+// Fused MoE activation + down-projection input transform over expert-sorted rows:
+// clamp (limit > 0), act (0: SiLU gate*sigmoid(gate)*up, 1: SwiGLU-OAI
+// gate*sigmoid(alpha*gate)*(up+1)), round to fp16, then the pre-scaled 128-wide
+// Hadamard with row r's scale vector scale_ptrs[row_group[r]]. Same math as the
+// torch clamp/act/cast followed by had_r_128(act_h, out, suh), in one pass.
+__global__ __launch_bounds__(32)
+void act_had_r_128_grouped_kernel(
+    const float* __restrict__ gate,
+    const float* __restrict__ up,
+    half* __restrict__ output_ptr,
+    const int* __restrict__ row_group,
+    const int64_t* __restrict__ scale_ptrs,
+    const float limit,
+    const float alpha,
+    const int act,
+    const float r_scale)
+{
+    __shared__ __align__(16) half act_h[128];
+    const int t = threadIdx.x;
+    const size_t off = (size_t) gridDim.y * 128 * blockIdx.x + blockIdx.y * 128 + t * 4;
+    const float4 g4 = *reinterpret_cast<const float4*>(gate + off);
+    const float4 u4 = *reinterpret_cast<const float4*>(up + off);
+    float g[4] = {g4.x, g4.y, g4.z, g4.w};
+    float u[4] = {u4.x, u4.y, u4.z, u4.w};
+    #pragma unroll
+    for (int i = 0; i < 4; ++i)
+    {
+        if (limit > 0.0f)
+        {
+            g[i] = fminf(g[i], limit);
+            u[i] = fminf(fmaxf(u[i], -limit), limit);
+        }
+        float a = act == 1
+            ? g[i] * (1.0f / (1.0f + __expf(-alpha * g[i]))) * (u[i] + 1.0f)
+            : g[i] * (1.0f / (1.0f + __expf(-g[i]))) * u[i];
+        act_h[t * 4 + i] = __float2half_rn(a);
+    }
+    __syncwarp();
+    const half* scale = reinterpret_cast<const half*>(scale_ptrs[row_group[blockIdx.x]]);
+    output_ptr += (size_t) gridDim.y * 128 * blockIdx.x + blockIdx.y * 128;
+    had_hf_r_128_inner<true, false>(act_h, output_ptr, scale, r_scale);
+}
+
 void check_common(
     const at::Tensor& a,
     const at::Tensor& packed,
@@ -293,6 +518,52 @@ void launch(int64_t K, bool mcg, bool mul1, at::Tensor a, at::Tensor packed, at:
     else launch_cb<0, scatter>(K, a, packed, out, svh, token_idx, route_weight);
 }
 
+
+template <int K, int CB, bool scatter>
+void launch_grouped_k(
+    at::Tensor a, at::Tensor packed_ptrs, at::Tensor out, at::Tensor svh_ptrs, at::Tensor row_bounds,
+    at::Tensor token_idx, at::Tensor route_weight, int64_t size_n, int64_t max_rows)
+{
+    const at::cuda::OptionalCUDAGuard device_guard(a.device());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+    int groups = static_cast<int>(packed_ptrs.numel());
+    int size_k = static_cast<int>(a.size(1));
+    dim3 block(FAT_THREADS);
+    dim3 grid(static_cast<int>(size_n) / FAT_TILE_N, (static_cast<int>(max_rows) + FAT_TILE_M - 1) / FAT_TILE_M, groups);
+    size_t shared = FAT_K_SUB * FAT_TILE_M * FAT_TILE_K * sizeof(half)
+                  + FAT_K_SUB * FAT_N_BLOCKS * 16 * K * sizeof(uint16_t)
+                  + 16 * FAT_TILE_N * sizeof(float);
+    exl3_fat_gemm_grouped_kernel<K, CB, scatter><<<grid, block, shared, stream>>>(
+        reinterpret_cast<const half*>(a.data_ptr()),
+        reinterpret_cast<const int64_t*>(packed_ptrs.data_ptr()),
+        reinterpret_cast<float*>(out.data_ptr()),
+        reinterpret_cast<const int64_t*>(svh_ptrs.data_ptr()),
+        reinterpret_cast<const int*>(row_bounds.data_ptr()),
+        scatter ? reinterpret_cast<const int64_t*>(token_idx.data_ptr()) : nullptr,
+        scatter ? reinterpret_cast<const half*>(route_weight.data_ptr()) : nullptr,
+        size_k,
+        static_cast<int>(size_n));
+    cuda_check(cudaPeekAtLastError());
+}
+
+template <int CB, bool scatter>
+void launch_grouped_cb(int64_t K, at::Tensor a, at::Tensor pp, at::Tensor out, at::Tensor sp, at::Tensor rs,
+                       at::Tensor ti, at::Tensor rw, int64_t n, int64_t mr)
+{
+    switch (K)
+    {
+        case 1: launch_grouped_k<1, CB, scatter>(a, pp, out, sp, rs, ti, rw, n, mr); break;
+        case 2: launch_grouped_k<2, CB, scatter>(a, pp, out, sp, rs, ti, rw, n, mr); break;
+        case 3: launch_grouped_k<3, CB, scatter>(a, pp, out, sp, rs, ti, rw, n, mr); break;
+        case 4: launch_grouped_k<4, CB, scatter>(a, pp, out, sp, rs, ti, rw, n, mr); break;
+        case 5: launch_grouped_k<5, CB, scatter>(a, pp, out, sp, rs, ti, rw, n, mr); break;
+        case 6: launch_grouped_k<6, CB, scatter>(a, pp, out, sp, rs, ti, rw, n, mr); break;
+        case 7: launch_grouped_k<7, CB, scatter>(a, pp, out, sp, rs, ti, rw, n, mr); break;
+        case 8: launch_grouped_k<8, CB, scatter>(a, pp, out, sp, rs, ti, rw, n, mr); break;
+        default: TORCH_CHECK(false, "exl3_fat_gemm_grouped: unsupported K ", K);
+    }
+}
+
 }  // namespace
 
 void exl3_fat_gemm(
@@ -335,3 +606,90 @@ void exl3_fat_gemm_scatter(
                 "routing tensors must share a device with a");
     launch<true>(K, mcg, mul1, a, packed, out, svh, token_idx, route_weight);
 }
+
+// Grouped variants: one launch for every expert of one (K, codebook) class.
+// ``a`` holds the expert-sorted rows; expert g owns rows [row_bounds[2g], row_bounds[2g+1]);
+// packed_ptrs / svh_ptrs are int64 device tables of its trellis and svh base pointers.
+// max_rows bounds the per-expert row count (grid y). Scatter accumulates
+// route_weight * row into out[token_idx[row]] (one route per token per expert).
+void exl3_fat_gemm_grouped(
+    at::Tensor a, at::Tensor packed_ptrs, at::Tensor out, at::Tensor svh_ptrs, at::Tensor row_bounds,
+    at::Tensor token_idx, at::Tensor route_weight, int64_t K, bool mcg, bool mul1, bool scatter,
+    int64_t size_n, int64_t max_rows)
+{
+    TORCH_CHECK(a.is_cuda() && a.scalar_type() == at::kHalf && a.is_contiguous() && a.dim() == 2,
+                "a must be a contiguous float16 CUDA matrix");
+    TORCH_CHECK(out.scalar_type() == at::kFloat && out.is_contiguous() && out.size(1) == size_n,
+                "out must be contiguous float32 [*, size_n]");
+    TORCH_CHECK(packed_ptrs.scalar_type() == at::kLong && svh_ptrs.scalar_type() == at::kLong &&
+                packed_ptrs.numel() == svh_ptrs.numel(), "pointer tables must be int64 of equal length");
+    TORCH_CHECK(row_bounds.scalar_type() == at::kInt && row_bounds.numel() == 2 * packed_ptrs.numel(),
+                "row_bounds must be int32 [2 * groups] (start, end) pairs");
+    TORCH_CHECK(K >= 1 && K <= 8, "K 1..8");
+    TORCH_CHECK(!(mcg && mul1), "mcg and mul1 are exclusive");
+    TORCH_CHECK(size_n % FAT_TILE_N == 0 && a.size(1) % (FAT_TILE_K * FAT_K_SUB) == 0, "size_n % 128, size_k % 64");
+    if (packed_ptrs.numel() == 0 || max_rows <= 0) return;
+    if (scatter)
+    {
+        TORCH_CHECK(token_idx.scalar_type() == at::kLong && route_weight.scalar_type() == at::kHalf &&
+                    token_idx.numel() == a.size(0) && route_weight.numel() == a.size(0),
+                    "scatter needs int64 token_idx and float16 route_weight per row");
+        if (mcg) launch_grouped_cb<1, true>(K, a, packed_ptrs, out, svh_ptrs, row_bounds, token_idx, route_weight, size_n, max_rows);
+        else if (mul1) launch_grouped_cb<2, true>(K, a, packed_ptrs, out, svh_ptrs, row_bounds, token_idx, route_weight, size_n, max_rows);
+        else launch_grouped_cb<0, true>(K, a, packed_ptrs, out, svh_ptrs, row_bounds, token_idx, route_weight, size_n, max_rows);
+    }
+    else
+    {
+        TORCH_CHECK(out.size(0) == a.size(0), "non-scatter out must have a's rows");
+        if (mcg) launch_grouped_cb<1, false>(K, a, packed_ptrs, out, svh_ptrs, row_bounds, at::Tensor(), at::Tensor(), size_n, max_rows);
+        else if (mul1) launch_grouped_cb<2, false>(K, a, packed_ptrs, out, svh_ptrs, row_bounds, at::Tensor(), at::Tensor(), size_n, max_rows);
+        else launch_grouped_cb<0, false>(K, a, packed_ptrs, out, svh_ptrs, row_bounds, at::Tensor(), at::Tensor(), size_n, max_rows);
+    }
+}
+
+// gather: empty, or int64 [output rows] of input rows (fused index_select).
+void exl3_had_r_128_grouped(at::Tensor input, at::Tensor output, at::Tensor row_group, at::Tensor scale_ptrs,
+                            at::Tensor gather)
+{
+    const bool gathered = gather.numel() > 0;
+    TORCH_CHECK(input.scalar_type() == at::kHalf && output.scalar_type() == at::kHalf &&
+                input.is_contiguous() && output.is_contiguous() && input.dim() == 2 && output.dim() == 2 &&
+                input.size(1) == output.size(1) && input.size(1) % 128 == 0,
+                "contiguous float16 [rows, 128*n] in/out");
+    TORCH_CHECK(gathered ? (gather.scalar_type() == at::kLong && gather.numel() == output.size(0))
+                         : input.size(0) == output.size(0), "gather int64 [output rows], or equal row counts");
+    TORCH_CHECK(row_group.scalar_type() == at::kInt && row_group.numel() == output.size(0), "row_group int32 [rows]");
+    TORCH_CHECK(scale_ptrs.scalar_type() == at::kLong, "scale_ptrs int64");
+    if (output.size(0) == 0) return;
+    const at::cuda::OptionalCUDAGuard device_guard(input.device());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+    dim3 grid(static_cast<int>(output.size(0)), static_cast<int>(output.size(1) / 128));
+    had_hf_r_128_grouped_kernel<<<grid, 32, 0, stream>>>(
+        reinterpret_cast<const half*>(input.data_ptr()), reinterpret_cast<half*>(output.data_ptr()),
+        reinterpret_cast<const int*>(row_group.data_ptr()), reinterpret_cast<const int64_t*>(scale_ptrs.data_ptr()),
+        gathered ? reinterpret_cast<const int64_t*>(gather.data_ptr()) : nullptr, 0.088388347648f);
+    cuda_check(cudaPeekAtLastError());
+}
+
+void exl3_act_had_r_128_grouped(at::Tensor gate, at::Tensor up, at::Tensor output, at::Tensor row_group,
+                                at::Tensor scale_ptrs, double limit, double alpha, int64_t act)
+{
+    TORCH_CHECK(gate.scalar_type() == at::kFloat && up.scalar_type() == at::kFloat && gate.is_contiguous() &&
+                up.is_contiguous() && gate.sizes() == up.sizes() && gate.dim() == 2 && gate.size(1) % 128 == 0,
+                "gate/up contiguous float32 [rows, 128*n]");
+    TORCH_CHECK(output.scalar_type() == at::kHalf && output.is_contiguous() && output.sizes() == gate.sizes(),
+                "output contiguous float16 like gate");
+    TORCH_CHECK(row_group.scalar_type() == at::kInt && row_group.numel() == gate.size(0), "row_group int32 [rows]");
+    TORCH_CHECK(scale_ptrs.scalar_type() == at::kLong, "scale_ptrs int64");
+    TORCH_CHECK(act == 0 || act == 1, "act 0 (SiLU) or 1 (SwiGLU-OAI)");
+    if (gate.size(0) == 0) return;
+    const at::cuda::OptionalCUDAGuard device_guard(gate.device());
+    cudaStream_t stream = at::cuda::getCurrentCUDAStream().stream();
+    dim3 grid(static_cast<int>(gate.size(0)), static_cast<int>(gate.size(1) / 128));
+    act_had_r_128_grouped_kernel<<<grid, 32, 0, stream>>>(
+        reinterpret_cast<const float*>(gate.data_ptr()), reinterpret_cast<const float*>(up.data_ptr()),
+        reinterpret_cast<half*>(output.data_ptr()), reinterpret_cast<const int*>(row_group.data_ptr()),
+        reinterpret_cast<const int64_t*>(scale_ptrs.data_ptr()), static_cast<float>(limit), static_cast<float>(alpha),
+        static_cast<int>(act), 0.088388347648f);
+    cuda_check(cudaPeekAtLastError());
+}
