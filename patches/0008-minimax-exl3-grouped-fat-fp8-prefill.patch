diff --git a/src/vllm_exl3/exl3.py b/src/vllm_exl3/exl3.py
index 46f2920..a503d15 100644
--- a/src/vllm_exl3/exl3.py
+++ b/src/vllm_exl3/exl3.py
@@ -3065,6 +3065,151 @@ def _fat_kernel_available() -> bool:
     return bool(native_c and hasattr(native_c, "exl3_fat_gemm"))
 
 
+def _fat_grouped_available() -> bool:
+    native_c = _load_native_exl3_ext()
+    return bool(native_c and hasattr(native_c, "exl3_fat_gemm_grouped") and hasattr(native_c, "exl3_act_had_r_128_grouped"))
+
+
+def _fat_grouped_tables(layer: Any, inners: list[dict[str, Any]]) -> dict[str, Any] | None:
+    """Per-layer device pointer tables for the grouped fat path (built once).
+
+    Each expert's gate/up/down LinearEXL3 keeps its trellis, suh and svh in place
+    for the life of the engine (arena views), so their base pointers can be
+    tabulated once. Returns None when the layer does not fit the grouped kernels.
+    """
+    cached = getattr(layer, "_exl3_fat_grouped_tables", False)
+    if cached is not False:
+        return cached
+    tables = None
+    try:
+        dev = inners[0]["down"].trellis.device
+        gated = all(inn.get("gate") is not None for inn in inners)
+        if gated:
+            tables = {"shared_suh": all(
+                bool(inn.get("_exl3_gate_up_shared_suh", torch.equal(inn["gate"].suh, inn["up"].suh)))
+                for inn in inners
+            )}
+            for proj in ("gate", "up", "down"):
+                lins = [inn[proj] for inn in inners]
+                if not all(l.trellis.is_contiguous() and l.svh.is_contiguous() and l.suh.is_contiguous() for l in lins):
+                    raise ValueError(f"{proj}: non-contiguous expert tensors")
+                tables[proj] = {
+                    "trellis": torch.tensor([l.trellis.data_ptr() for l in lins], dtype=torch.int64, device=dev),
+                    "svh": torch.tensor([l.svh.data_ptr() for l in lins], dtype=torch.int64, device=dev),
+                    "suh": torch.tensor([l.suh.data_ptr() for l in lins], dtype=torch.int64, device=dev),
+                    "class": [(int(l.K), bool(l.mcg), bool(l.mul1)) for l in lins],
+                    "out": int(lins[0].out_features),
+                }
+            # Grouped GEMM tiles: N in 128s, K in 64-wide pipeline stages.
+            in_features = int(inners[0]["gate"].trellis.shape[0]) * 16
+            if tables["gate"]["out"] % 128 or tables["down"]["out"] % 128 or in_features % 64 or tables["gate"]["out"] % 64:
+                tables = None
+    except Exception as exc:  # never break a forward over an optional fast path
+        logger.warning("EXL3 grouped fat path unavailable for this layer: %r", exc)
+        tables = None
+    layer._exl3_fat_grouped_tables = tables
+    return tables
+
+
+def apply_exl3_grouped_fat(
+    xh: torch.Tensor,
+    token_sorted: torch.Tensor,
