+        def sliced():
+            for s in range(0, n, chunk):
+                torch._scaled_mm(a, w[s:s + chunk].t(), scale_a=one, scale_b=one, out_dtype=torch.float32,
+                                 out=out[:, s:s + chunk])
+
+        try:
+            t = timeit(sliced)
+            res.append(f"fp32 sliced{chunk} {flops / t / 1e9:.0f}")
+        except Exception as exc:
+            res.append(f"sliced{chunk} ERR {str(exc)[:80]}")
+    print(f"M={m} {k}->{n} TFLOPS: " + " | ".join(res))
