+import torch, sys
+import vllm_exl3_c as nat
+from exllamav3.ext import exllamav3_ext as ext
+torch.manual_seed(0)
+print("EXL3_FAT_GEMM_MAX_K", nat.EXL3_FAT_GEMM_MAX_K)
+dev = "cuda"
+fails = 0
+for K in (2, 3, 4, 5):
+    for mcg, mul1 in ((True, False), (False, True), (False, False)):
+        M, IN, OUT = 300, 3072, 768
+        a = (torch.randn(M, IN, device=dev) * 0.5).half()
+        tr = torch.randint(-32768, 32767, (IN // 16, OUT // 16, 16 * K), dtype=torch.int16, device=dev)
+        svh = (torch.rand(OUT, device=dev) + 0.5).half()
+        w = torch.empty(IN, OUT, dtype=torch.half, device=dev)
+        ext.reconstruct(w, tr, K, mcg, mul1)
+        ref = torch.empty(M, OUT, dtype=torch.half, device=dev)
+        ext.hgemm(a, w, ref)
+        ref32 = ref.float().contiguous()
+        ext.had_r_128(ref32, ref32, None, svh, 1.0)
+        out = torch.empty(M, OUT, dtype=torch.float32, device=dev)
+        nat.exl3_fat_gemm(a, tr, out, svh, K, mcg, mul1)
+        rel = ((out - ref32).norm() / ref32.norm()).item()
+        # scatter variant
+        idx = torch.randperm(M, device=dev).long()
+        wt = (torch.rand(M, device=dev)).half()
+        sc = torch.zeros(M, OUT, dtype=torch.float32, device=dev)
+        nat.exl3_fat_gemm_scatter(a, tr, sc, svh, idx, wt, K, mcg, mul1)
+        ref_sc = torch.zeros_like(sc); ref_sc.index_add_(0, idx, ref32 * wt.float().unsqueeze(1))
+        rel_sc = ((sc - ref_sc).norm() / ref_sc.norm()).item()
+        ok = rel < 1e-2 and rel_sc < 1e-2
+        fails += not ok
+        print(f"K={K} mcg={mcg} mul1={mul1}: gemm rel err {rel:.2e}, scatter rel err {rel_sc:.2e} {'OK' if ok else 'FAIL'}")
+sys.exit(1 if fails else 0)
diff --git a/tests/gpu/test_fat_gemm_grouped.py b/tests/gpu/test_fat_gemm_grouped.py
new file mode 100644
index 0000000..0e3a5bb
--- /dev/null
+++ b/tests/gpu/test_fat_gemm_grouped.py
@@ -0,0 +1,205 @@
+"""Grouped fat kernels vs the per-expert native kernels (run inside the image, on a GPU).
+
+exl3_fat_gemm_grouped must equal one exl3_fat_gemm call per expert on that expert's row
+span, and its scatter variant must equal per-expert scatters into a shared output where
+experts share tokens. exl3_had_r_128_grouped must equal exllamav3 had_r_128 with each
+row's expert pre-scale. Then times the per-expert loop against one grouped launch on the
+2.15 lane's per-rank shapes.
+"""
+import sys
+import time
+
+import torch
+import vllm_exl3_c as nat
+from exllamav3.ext import exllamav3_ext as ext
+
+torch.manual_seed(0)
+dev = "cuda"
+fails = 0
+
+
+def rel(x, y):
+    return ((x - y).norm() / y.norm()).item()
+
+
+def experts(n, size_in, size_out, k):
+    tr = [torch.randint(-32768, 32767, (size_in // 16, size_out // 16, 16 * k), dtype=torch.int16, device=dev)
+          for _ in range(n)]
+    svh = [(torch.rand(size_out, device=dev) + 0.5).half() for _ in range(n)]
+    return tr, svh
+
+
+def ptrs(ts):
+    return torch.tensor([t.data_ptr() for t in ts], dtype=torch.int64, device=dev)
+
+
+for k, mcg, mul1 in ((2, False, False), (3, True, False), (4, False, True), (5, False, False)):
+    counts = [300, 1, 0, 129, 64, 257]
+    size_in, size_out = 1024, 768
+    rows = sum(counts)
+    a = (torch.randn(rows, size_in, device=dev) * 0.5).half()
+    tr, svh = experts(len(counts), size_in, size_out, k)
+    starts = [0]
+    for n in counts:
+        starts.append(starts[-1] + n)
+    bounds = torch.tensor([b for g in range(len(counts)) for b in (starts[g], starts[g + 1])],
+                          dtype=torch.int32, device=dev)
+    ref = torch.zeros(rows, size_out, dtype=torch.float32, device=dev)
+    for g, n in enumerate(counts):
+        if n:
+            nat.exl3_fat_gemm(a[starts[g]:starts[g + 1]].contiguous(), tr[g], ref[starts[g]:starts[g + 1]], svh[g],
+                              k, mcg, mul1)
+    out = torch.zeros_like(ref)
+    empty_l = torch.empty(0, dtype=torch.long, device=dev)
+    empty_h = torch.empty(0, dtype=torch.float16, device=dev)
+    nat.exl3_fat_gemm_grouped(a, ptrs(tr), out, ptrs(svh), bounds, empty_l, empty_h, k, mcg, mul1, False,
+                              size_out, max(counts))
+    r_gemm = rel(out, ref)
+    # Scatter: 200 tokens, each expert's rows pick distinct tokens, experts overlap.
+    tokens = 400
+    tok = torch.cat([torch.randperm(tokens, device=dev)[:n] for n in counts]).long()
+    wts = torch.rand(rows, device=dev).half()
+    ref_sc = torch.zeros(tokens, size_out, dtype=torch.float32, device=dev)
+    for g, n in enumerate(counts):
+        if n:
+            s, e = starts[g], starts[g + 1]
+            nat.exl3_fat_gemm_scatter(a[s:e].contiguous(), tr[g], ref_sc, svh[g], tok[s:e].contiguous(),
+                                      wts[s:e].contiguous(), k, mcg, mul1)
+    sc = torch.zeros_like(ref_sc)
+    nat.exl3_fat_gemm_grouped(a, ptrs(tr), sc, ptrs(svh), bounds, tok, wts, k, mcg, mul1, True, size_out,
+                              max(counts))
+    r_sc = rel(sc, ref_sc)
+    ok = r_gemm < 1e-5 and r_sc < 1e-4
+    fails += not ok
+    print(f"K={k} mcg={mcg} mul1={mul1}: grouped gemm rel {r_gemm:.1e}, grouped scatter rel {r_sc:.1e} "
+          f"{'OK' if ok else 'FAIL'}")
+
+# Real per-rank shapes with skewed loads: gate (6144 -> 1536) and down (1536 -> 6144, scatter).
+for size_in, size_out, k, scatter in ((6144, 1536, 2, False), (1536, 6144, 3, True)):
+    counts = [2000, 65, 300, 1, 129, 700]
+    rows = sum(counts)
+    a = (torch.randn(rows, size_in, device=dev) * 0.5).half()
+    tr, svh = experts(len(counts), size_in, size_out, k)
+    starts = [0]
+    for n in counts:
+        starts.append(starts[-1] + n)
+    bounds = torch.tensor([b for g in range(len(counts)) for b in (starts[g], starts[g + 1])],
+                          dtype=torch.int32, device=dev)
+    tokens = 2048
+    tok = torch.cat([torch.randperm(tokens, device=dev)[:n] for n in counts]).long()
+    wts = torch.rand(rows, device=dev).half()
+    ref = torch.zeros(tokens if scatter else rows, size_out, dtype=torch.float32, device=dev)
+    for g, n in enumerate(counts):
+        s0, e0 = starts[g], starts[g + 1]
+        if scatter:
+            nat.exl3_fat_gemm_scatter(a[s0:e0].contiguous(), tr[g], ref, svh[g], tok[s0:e0].contiguous(),
+                                      wts[s0:e0].contiguous(), k, False, False)
+        else:
+            nat.exl3_fat_gemm(a[s0:e0].contiguous(), tr[g], ref[s0:e0], svh[g], k, False, False)
+    out = torch.zeros_like(ref)
+    nat.exl3_fat_gemm_grouped(a, ptrs(tr), out, ptrs(svh), bounds, tok if scatter else empty_l,
+                              wts if scatter else empty_h, k, False, False, scatter, size_out, max(counts))
+    r = rel(out, ref)
+    # Independent reference for the biggest expert: reconstruct + hgemm + output Hadamard.
+    w = torch.empty(size_in, size_out, dtype=torch.half, device=dev)
+    ext.reconstruct(w, tr[0], k, False, False)
+    r0 = torch.empty(counts[0], size_out, dtype=torch.half, device=dev)
+    ext.hgemm(a[:counts[0]].contiguous(), w, r0)
+    r0 = r0.float().contiguous()
+    ext.had_r_128(r0, r0, None, svh[0], 1.0)
+    if scatter:
+        mine = torch.zeros(tokens, size_out, dtype=torch.float32, device=dev)
+        nat.exl3_fat_gemm_grouped(a, ptrs(tr[:1]), mine, ptrs(svh[:1]), bounds[:2], tok, wts, k, False, False,
+                                  True, size_out, counts[0])
+        ref0 = torch.zeros_like(mine)
+        ref0.index_add_(0, tok[:counts[0]], r0 * wts[:counts[0]].float().unsqueeze(1))
+    else:
+        mine, ref0 = out[:counts[0]], r0
+    r_ind = rel(mine, ref0)
+    ok = r < 1e-4 and r_ind < 1e-2
+    fails += not ok
+    print(f"{size_in}->{size_out} K={k} scatter={scatter} skewed: grouped vs per-expert {r:.1e}, "
+          f"vs reconstruct ref {r_ind:.1e} {'OK' if ok else 'FAIL'}")
+
+# Grouped Hadamard
+counts = [5, 0, 17, 3]
+cols = 1024
+x = torch.randn(sum(counts), cols, device=dev).half()
+scales = [(torch.rand(cols, device=dev) + 0.5).half() for _ in counts]
+row_group = torch.repeat_interleave(torch.arange(len(counts), dtype=torch.int32, device=dev),
+                                    torch.tensor(counts, device=dev))
+y = torch.empty_like(x)
+nat.exl3_had_r_128_grouped(x, y, row_group, ptrs(scales), empty_l)
+ref = torch.empty_like(x)
+s = 0
+for g, n in enumerate(counts):
+    if n:
+        ext.had_r_128(x[s:s + n].contiguous(), ref[s:s + n], scales[g], None, 1.0)
+    s += n
+r_had = rel(y.float(), ref.float())
+# Fused gather: output row r reads source row gather[r].
+src = torch.randn(64, cols, device=dev).half()
+gather = torch.randint(0, 64, (x.shape[0],), device=dev).long()
+yg = torch.empty_like(x)
+nat.exl3_had_r_128_grouped(src, yg, row_group, ptrs(scales), gather)
+refg = torch.empty_like(x)
+nat.exl3_had_r_128_grouped(src.index_select(0, gather).contiguous(), refg, row_group, ptrs(scales), empty_l)
+r_gather = rel(yg.float(), refg.float())
+ok = r_had < 1e-6 and r_gather == 0.0
+fails += not ok
+print(f"grouped had rel {r_had:.1e}, gathered had rel {r_gather:.1e} {'OK' if ok else 'FAIL'}")
+
+# Fused clamp + activation + fp16 round + Hadamard vs the torch sequence the per-expert path runs.
+gate_f = torch.randn(x.shape[0], cols, device=dev) * 4
+up_f = torch.randn(x.shape[0], cols, device=dev) * 4
+for act, limit in ((1, 7.0), (1, 0.0), (0, 7.0)):
+    g, u = gate_f.clone(), up_f.clone()
+    if limit > 0:
+        g.clamp_(max=limit)
+        u.clamp_(min=-limit, max=limit)
+    a = torch.sigmoid(g * 1.702) * g * (u + 1.0) if act == 1 else torch.sigmoid(g) * g * u
+    ref = torch.empty(x.shape[0], cols, dtype=torch.float16, device=dev)
+    nat.exl3_had_r_128_grouped(a.half().contiguous(), ref, row_group, ptrs(scales), empty_l)
+    yo = torch.empty_like(ref)
+    nat.exl3_act_had_r_128_grouped(gate_f, up_f, yo, row_group, ptrs(scales), limit, 1.702, act)
+    r_act = rel(yo.float(), ref.float())
+    ok = r_act < 2e-3
+    fails += not ok
+    print(f"fused act={act} limit={limit}: rel {r_act:.1e} {'OK' if ok else 'FAIL'}")
+
+# Timing on the 2.15 lane's per-rank gate shape: 128 experts, ~256 rows each (8K tokens, top-4), K3.
+k, n_exp, size_in, size_out = 3, 128, 6144, 1536
+counts = torch.multinomial(torch.ones(n_exp), 8192 * 4, replacement=True).bincount(minlength=n_exp).tolist()
+rows = sum(counts)
+a = (torch.randn(rows, size_in, device=dev) * 0.5).half()
+tr, svh = experts(n_exp, size_in, size_out, k)
+starts = [0]
+for n in counts:
+    starts.append(starts[-1] + n)
+bounds = torch.tensor([b for g in range(n_exp) for b in (starts[g], starts[g + 1])], dtype=torch.int32, device=dev)
+out = torch.empty(rows, size_out, dtype=torch.float32, device=dev)
+views = [(a[starts[g]:starts[g + 1]], out[starts[g]:starts[g + 1]]) for g in range(n_exp)]
+tp, sp = ptrs(tr), ptrs(svh)
+
+
+def loop():
+    for g, (av, ov) in enumerate(views):
+        nat.exl3_fat_gemm(av, tr[g], ov, svh[g], k, False, False)
+
+
+def grouped():
+    nat.exl3_fat_gemm_grouped(a, tp, out, sp, bounds, empty_l, empty_h, k, False, False, False, size_out,
+                              max(counts))
+
+
+for name, fn in (("per-expert loop", loop), ("grouped", grouped)):
+    fn()
+    torch.cuda.synchronize()
+    t = time.perf_counter()
+    for _ in range(10):
+        fn()
+    torch.cuda.synchronize()
+    ms = (time.perf_counter() - t) * 100
+    tflops = 2 * rows * size_in * size_out / (ms * 1e-3) / 1e12
+    print(f"{name}: {ms:.2f} ms ({tflops:.1f} TFLOPS) for {rows} rows over {n_exp} experts, {size_in}->{size_out}")
+sys.exit(1 if fails else 0)
diff --git a/tests/gpu/test_fp8_dense_prefill.py b/tests/gpu/test_fp8_dense_prefill.py
new file mode 100644
index 0000000..394b2fa
--- /dev/null
+++ b/tests/gpu/test_fp8_dense_prefill.py
@@ -0,0 +1,130 @@
+"""FP8 dense prefill (exl3._dense_forward_fp8) vs the fp16 EXL3 reconstruct path (run in the image).
+
+1. Kernel exactness: the FP8 path equals an fp32 emulation of the same quantized math
+   (dequantized xq/wq, fp32 matmul, Hadamards) to bf16-accumulator precision.
+2. End-to-end error vs LinearEXL3's fp16 path on activations with outlier channels.
+3. Timing vs the fp16 path at the 2.15 lane's per-rank prefill shapes.
+"""
+import sys
+import time
+import types
+
+sys.path.insert(0, "/src/src")
+import torch
+from exllamav3.ext import exllamav3_ext as ext
+
+from vllm_exl3 import exl3 as X
+
+dev = "cuda"
+torch.manual_seed(0)
+nat = X._load_native_exl3_ext()
+fails = 0
+
+
+def rel(a, b):
+    return ((a - b).norm() / b.norm()).item()
+
+
+def make_linear(k, n, bits):
+    tr = torch.randint(-32768, 32767, (k // 16, n // 16, 16 * bits), dtype=torch.int16, device=dev)
+    suh = torch.where(torch.rand(k, device=dev) < 0.5, -1.0, 1.0).half() * (torch.rand(k, device=dev) * 0.5 + 0.75).half()
+    svh = (torch.rand(n, device=dev) * 0.02 + 0.01).half()
+    return types.SimpleNamespace(in_features=k, out_features=n, trellis=tr, K=bits, mcg=True, mul1=False,
+                                 suh=suh, svh=svh, bias=None)
+
+
+def fp16_ref(lin, x):
+    xh = torch.empty_like(x)
+    ext.had_r_128(x, xh, lin.suh, None, 1.0)
+    w = torch.empty(lin.in_features, lin.out_features, dtype=torch.half, device=dev)
+    ext.reconstruct(w, lin.trellis, lin.K, lin.mcg, lin.mul1)
+    y = (xh.float() @ w.float()).contiguous()
+    ext.had_r_128(y, y, None, lin.svh, 1.0)
+    return y
+
+
+def emulate(lin, x):
+    k, n = lin.in_features, lin.out_features
+    w = torch.empty(k, n, dtype=torch.half, device=dev)
+    ext.reconstruct(w, lin.trellis, lin.K, lin.mcg, lin.mul1)
+    ws = lin._exl3_fp8_w_scale
+    wq = torch.empty(n, k, dtype=torch.float8_e4m3fn, device=dev)
+    nat.exl3_fp16_to_fp8_t(w, wq, 1.0 / ws)
+    xq = torch.empty(x.shape, dtype=torch.float8_e4m3fn, device=dev)
+    rs = torch.empty(x.shape[0], dtype=torch.float32, device=dev)
+    nat.exl3_had_quant_fp8_rows(x, lin.suh, xq, rs)
+    # Independent checks of the two quantizers.
+    xh = torch.empty_like(x)
+    ext.had_r_128(x, xh, lin.suh, None, 1.0)
+    q_in = rel(xq.float() * rs[:, None], xh.float())
+    q_w = rel(wq.float().t() * ws, w.float())
+    y = (xq.float() * rs[:, None]) @ (wq.float().t() * ws)
+    y = y.contiguous()
+    ext.had_r_128(y, y, None, lin.svh, 1.0)
+    return y, q_in, q_w
+
+
+for k, n, bits in ((6144, 3072, 3), (3072, 6144, 2), (6144, 12288, 4)):
+    lin = make_linear(k, n, bits)
+    x = torch.randn(2048, k, device=dev)
+    x[:, torch.randperm(k)[:8]] *= 60.0  # outlier channels
+    x[0] *= 30.0  # one huge-norm row (attention-sink-like token)
+    x = x.half().contiguous()
+    y = X._dense_forward_fp8(lin, x)
+    emu, q_in, q_w = emulate(lin, x)
+    ref = fp16_ref(lin, x)
+    r_emu, r_ref = rel(y, emu), rel(y, ref)
+    ok = r_emu < 1e-2 and r_ref < 8e-2 and torch.isfinite(y).all().item()
+    fails += not ok
+    print(f"{k}->{n} K{bits}: vs fp32 emulation {r_emu:.1e} | vs fp16 EXL3 {r_ref:.1e} "
+          f"(input quant {q_in:.1e}, weight quant {q_w:.1e}) {'OK' if ok else 'FAIL'}")
+
+
+# bf16 input written into a bf16 column slice equals the fp32-output call on the same input.
+lin = make_linear(3072, 1024, 3)
+xb = (torch.randn(1500, 3072, device=dev) * 3).bfloat16()
+wide = torch.full((1500, 4096), float("nan"), dtype=torch.bfloat16, device=dev)
+X._dense_forward_fp8(lin, xb, out=wide[:, 1024:2048])
+ref32 = X._dense_forward_fp8(lin, xb)
+r_slice = rel(wide[:, 1024:2048].float(), ref32)
+untouched = bool(torch.isnan(wide[:, :1024]).all() and torch.isnan(wide[:, 2048:]).all())
+ok = r_slice < 1e-2 and untouched
+fails += not ok
+print(f"bf16 in -> bf16 slice out: rel {r_slice:.1e}, neighbours untouched {untouched} {'OK' if ok else 'FAIL'}")
+
+
+def timeit(fn, n=10):
+    fn()
+    torch.cuda.synchronize()
+    t = time.perf_counter()
+    for _ in range(n):
+        fn()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - t) / n * 1e3
+
+
+class FakeLinear:
+    """Enough of LinearEXL3.reconstruct_hgemm for timing the fp16 path on the same tensors."""
+
+
+for m in (8192,):
+    for k, n, bits in ((6144, 3072, 3), (3072, 6144, 2), (6144, 12288, 4), (6144, 6144, 3)):
+        lin = make_linear(k, n, bits)
+        x = torch.randn(m, k, device=dev).half()
+        w = torch.empty(k, n, dtype=torch.half, device=dev)
+        y16 = torch.empty(m, n, dtype=torch.float32, device=dev)
+
+        def fp16_path():
+            ext.reconstruct_had_slice(w, lin.trellis, lin.suh, lin.svh, lin.K, lin.mcg, lin.mul1, 0)
+            ext.hgemm_recon(x, w, y16)
+
+        t16 = timeit(fp16_path)
+        t8 = timeit(lambda: X._dense_forward_fp8(lin, x))
+        xb16 = x.bfloat16()
+        yb = torch.empty(m, n, dtype=torch.bfloat16, device=dev)
+        t8b = timeit(lambda: X._dense_forward_fp8(lin, xb16, out=yb))
+        # fp16 path including the caller's bf16->fp16 input copy and fp32->bf16 output cast
+        t16g = timeit(lambda: (fp16_path(), xb16.to(torch.float16), y16.to(torch.bfloat16)))
+        print(f"M={m} {k}->{n}: fp16 {t16:.2f} ms ({t16g:.2f} with caller casts) | fp8 fp32-out {t8:.2f} ms | "
+              f"fp8 bf16 in/out {t8b:.2f} ms ({t16g / t8b:.2f}x)")
+sys.exit(1 if fails else 0)
