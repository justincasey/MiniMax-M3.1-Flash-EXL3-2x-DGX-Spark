-    num_kv_heads: int, sm_scale: float, output, tile: int = 4, num_warps: int = 4, num_stages: int = 1,
+    q, kv_cache, topk_idx, block_table, cu_seqlens_q: torch.Tensor, seq_lens, prefix_lens: torch.Tensor,
+    num_kv_heads: int, sm_scale: float, output, tile: int = 8, num_warps: int = 8, num_stages: int = 1,
