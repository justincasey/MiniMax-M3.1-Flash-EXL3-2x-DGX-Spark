+def build_tiles(cu_seqlens_q: torch.Tensor, prefix_lens: torch.Tensor, total_q: int, tile: int):
+    """Tiles of ``tile`` consecutive rows that never cross a request boundary, on the GPU.
+
+    No host sync: the tile count is bounded from shapes (total_q // tile + num_reqs) and
+    surplus tiles get zero rows (the kernel exits on them).
+    """
+    dev = cu_seqlens_q.device
+    num_reqs = int(cu_seqlens_q.shape[0]) - 1
+    cu = cu_seqlens_q.reshape(-1).to(torch.int64)
+    lens = cu[1:] - cu[:-1]
+    ntile = (lens + tile - 1) // tile
+    ends = torch.cumsum(ntile, 0)
+    starts = ends - ntile
+    n_max = total_q // tile + num_reqs
+    t = torch.arange(n_max, device=dev, dtype=torch.int64)
+    req = torch.searchsorted(ends, t, right=True)
+    valid = req < num_reqs
+    req_c = torch.clamp(req, max=max(num_reqs - 1, 0))
+    local = t - starts[req_c]
+    q0 = cu[req_c] + local * tile
+    n = torch.clamp(lens[req_c] - local * tile, min=0, max=tile)
+    n = torch.where(valid, n, torch.zeros_like(n))
+    qabs0 = prefix_lens.reshape(-1).to(torch.int64)[req_c] + local * tile
+    i32 = lambda x: x.to(torch.int32).contiguous()
+    return i32(q0), i32(n), i32(req_c), i32(qabs0)
 
 
