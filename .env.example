# m31.sh configuration. Copy to .env and edit.
# Precedence: caller environment > .env > m31.sh defaults > config/profiles/.
# Release pins (model revision, image digest, fork revisions, patch, overlay)
# live in config/pins.sh and are not tuned here.

# ─── the two Sparks ─────────────────────────────────────────────────────────
# Management (LAN) addresses, rank 0 first. Rank 0 serves the API. Key-based
# ssh as SSH_USER must work from this machine to both.
NODES="192.0.2.11 192.0.2.12"
SSH_USER=spark

# ─── paths (same absolute path on both nodes) ───────────────────────────────
BASE_DIR=/home/spark/m31                  # tools, guards, fabric plan, run state
MODELS_DIR=/home/spark/models             # the pack lives in $MODELS_DIR/$MODEL_NAME
CACHE_DIR=/home/spark/.cache/m31          # Triton/CUDA/vLLM JIT caches, mounted at /cache
BUILD_DIR=/home/spark/build/m31           # image build context on rank 0 (needs ~10 GiB)
CONTAINER=m31-flash-tp2
MASTER_PORT=29511                         # torch.distributed rendezvous on rank 0

# ─── serving ────────────────────────────────────────────────────────────────
SERVED_NAME=minimax-m3.1-flash
HOST=0.0.0.0
PORT=8000
API_KEY=                                  # empty: no auth. Set one if the port is reachable beyond your desk.
PROFILE=q4-300k                           # config/profiles/<name>.env: q4-300k or a q4-215-{256k,512k}-{2,4,8}s profile
MAX_MODEL_LEN=                            # empty: the profile's value
MAX_NUM_SEQS=                             # empty: the profile's value
MAX_NUM_BATCHED_TOKENS=                   # empty: the profile's value, else 4096; multiple of block size 128
GPU_MEMORY_UTILIZATION=0.85               # startup free-memory gate only; the KV pool is pinned by KVB
KV_BYTES_PER_TOKEN=28160                  # only for profiles without KVB; measured cost is 27,520 B/token/rank (q4 main KV, fp8 indexer+draft)
KVB=                                      # empty: the profile's pinned pool (profiles without one derive it from KV_BYTES_PER_TOKEN)
KV_CACHE_DTYPE=nvfp4                      # q4 main KV layout through the plugin's VLLM_EXL3_Q4KV overlay
INDEXER_KV_DTYPE=fp8
KV_Q4=1                                   # 1: plugin q4 main-KV pool (requires the fp8 indexer and fp8 draft below)
INDEXER_MXFP8=1                           # keep index_q/index_k MXFP8 on device (+0.4-0.5 GiB free, measured on 2.15)
DEFAULT_MAX_TOKENS=32768                  # max_new_tokens default for requests that send none
WAIT_TIMEOUT=1800                         # seconds start waits for /v1/models
WARMUP=1                                  # run the short + ~8K warm-up before READY

# ─── DSpark speculative decoding ────────────────────────────────────────────
DSPARK=1                                  # the draft ships inside the pack (dspark/), resolved from the model path
NUM_SPECULATIVE_TOKENS=3                  # k=3 -> 4 tokens per verify step
DRAFT_ATTN_BACKEND=TRITON_ATTN            # the only fp8-draft pair that boots on GB10
DRAFT_KV_DTYPE=fp8
DRAFT_SAMPLE=probabilistic
REJECTION_SAMPLE=block
EAGER=0                                   # 1: no CUDA graphs (debugging only)
CAPTURE_SIZES=                            # empty: derived from MAX_NUM_SEQS x (k+1)
COMPILE_MODE=0                            # torch.compile mode (0 = off; measured best on GB10)

# ─── host resources and the memory guard ────────────────────────────────────
CONTAINER_MEMORY=118g                     # docker --memory and --memory-swap; empty: no cgroup limit
GUARD_START_MIB=2048                      # load-time MemAvailable floor (startup transient)
GUARD_MIB=1024                            # steady floor once the API answers
GUARD_SWAP_MAX_MIB=64
DROP_CACHES_EVERY_S=20                    # guard drops page cache this often while loading/serving (GB10 UMA)
CPUSET=                                   # e.g. 5-9,15-19; empty: no pin
NCCL_DEBUG=                               # e.g. INFO for link bring-up

# ─── the link (usually auto-detected by doctor/start) ───────────────────────
# Pin all seven of these or none; otherwise the shared RoCE subnet is detected
# and doctor prints what it picked for each rank.
# RANK0_IP=10.0.226.2
# RANK0_HCA=rocep1s0f1,roceP2p1s0f1
# RANK1_IP=10.0.226.1
# RANK1_HCA=rocep1s0f1,roceP2p1s0f1
# NCCL_IB_GID_INDEX=3
# FABRIC_IF_0=enp1s0f1np1
# FABRIC_IF_1=enp1s0f1np1

# ─── other stacks on the same GPUs ──────────────────────────────────────────
# start refuses to run next to any container not listed here.
ALLOWED_CONTAINERS=                       # space-separated names, e.g. a monitoring agent
# Commands run on this control machine by `./m31.sh stop-other` and
# `restore-other`, for another stack that normally owns these GPUs. Example:
# STOP_OTHER='cd "$HOME/recipes/other-stack" && ./serve.sh stop'
# RESTORE_OTHER='cd "$HOME/recipes/other-stack" && ./serve.sh start'

# ─── advanced ───────────────────────────────────────────────────────────────
EXTRA_VLLM_ARGS=                          # appended to vllm serve (space separated)
EXTRA_DOCKER_ARGS=                        # appended to docker run before the image
EXTRA_ENV=                                # space-separated KEY=VALUE passed into the container
HF_BIN=                                   # empty: <home>/venvs/hf/bin/hf on each node
HF_TOKEN=                                 # optional; the 2.15 pack is public
IMAGE=                                    # empty: m31-flash-exl3-tp2:<plugin-short>-<patch-short>
